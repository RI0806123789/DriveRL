# DriveRL の環境変数（すべて任意）
#
# このファイルを .env としてコピーすれば backend/app/config.py が読み込む。
# 指定しなければ括弧内の既定値が使われる。

# バックエンドの待ち受けアドレス（既定: 127.0.0.1）
DRIVERL_HOST=127.0.0.1

# バックエンドの待ち受けポート（既定: 8000）
# 変更したら frontend/vite.config.ts のプロキシ先も合わせること
DRIVERL_PORT=8000

# 実用モードの AI コンシェルジュが使う Gemini の API キー（既定: 空 = コンシェルジュを使わない）
# https://aistudio.google.com/apikey で発行する。.env は .gitignore 済みなので外へは出ない
GEMINI_API_KEY=your_gemini_api_key_here

# コンシェルジュが使うモデル（既定: gemini-3.1-flash-lite）
# GEMINI_MODEL=gemini-3.1-flash-lite

# GEMINI_MODEL が混み合っている（503 など）とき、試し直しの最後の 1 回だけ使うモデル（既定: 空 = 同じモデルで試し直す）
# GEMINI_FALLBACK_MODEL=

# 認識器（CNN）の推論を動かす先（既定: auto）
#   auto  = NPU（Intel AI Boost など）があれば NPU、無ければ OpenVINO の CPU
#   cpu   = NPU があっても OpenVINO の CPU
#   keras = OpenVINO を使わず、従来の Keras（torch）の CPU 推論
# openvino が入っていなければ auto でも keras と同じになる（pip install openvino で有効になる）
# DRIVERL_PERCEP_DEVICE=auto

# IP アドレスと localhost のほかに、ブラウザのアドレス欄で使う名前（カンマ区切り。既定: 空）
# スマホから http://mypc.local:8000 のように名前で開くときだけ書く。書いていない名前での接続は
# DNS リバインディング対策として 403 で断る（IP アドレスそのもので開くなら書かなくてよい）
# DRIVERL_ALLOWED_HOSTS=mypc.local

# 通常運転の詳細物理・交通シナリオは常時有効。環境変数での有効化は不要。
# 画面と環境変数から標準シナリオの選択・解除はできない。
