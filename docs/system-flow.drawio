    </diagram>
    <diagram id="page-loop" name="4. 実行時メインループ">
        <mxGraphModel dx="2339" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4-title" value="4. 実行時メインループ（物理 20Hz ＋ PPO オンライン学習）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1D1B20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p4-sub" value="すべてエンジンスレッド sim-engine の中で動く。asyncio 側は Lock 保護の共有変数を読むだけで、この流れに割り込まない。番号は実行順。&lt;b&gt;止まるものが 3 つあり、どれも別物&lt;/b&gt;（右端のレーンを参照）。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" vertex="1" parent="1">
                    <mxGeometry x="40" y="58" width="1700" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p4-la" value="engine._run()　外側ループ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#072711;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="400" height="1460" as="geometry"/>
                </mxCell>
                <mxCell id="p4-a1" value="&lt;b&gt;_drain_inbox()&lt;/b&gt;&lt;br&gt;set_map / params / event / command / taxi /&lt;br&gt;&lt;b&gt;player_pose&lt;/b&gt; / app_mode / resume_sim / reload_detector を取り出して反映" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="150" width="360" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p4-a2" value="env と trainer が用意できている？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="90" y="232" width="300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4-a3" value="&lt;b&gt;NO&lt;/b&gt;　time.sleep(0.05) で待つ（マップ未読込 ＝ idle）&lt;br&gt;&lt;b&gt;simSuspended のときも同じく飛ばす&lt;/b&gt;（認識器の学習中。配信とコマンドは動く）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="332" width="360" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p4-a4" value="&lt;b&gt;YES　_step_once()&lt;/b&gt; → 中央のレーンへ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="408" width="360" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4-a5" value="&lt;b&gt;実時間ペーシング&lt;/b&gt;&lt;br&gt;next_deadline += DT / sim_speed を&lt;b&gt;累積&lt;/b&gt;更新し、残り時間だけ sleep する。&lt;br&gt;計算が追いつかない場合は遅れを持ち越さず、現在時刻から引き直す（雪だるま防止）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="472" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4-an0" value="&lt;b&gt;止まるものが 3 つある（混ぜない）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;renderPaused&lt;/b&gt;：フレーム配信だけ止まる。&lt;br&gt;　物理も学習も動き続ける&lt;br&gt;&lt;b&gt;simSuspended&lt;/b&gt;：物理と PPO ごと止まる。&lt;br&gt;　認識器の学習中だけ（detector-train が&lt;br&gt;　suspend_sim / resume_sim を呼ぶ）&lt;br&gt;&lt;b&gt;practicalMode&lt;/b&gt;：&lt;b&gt;重みの更新だけ&lt;/b&gt;止まる。&lt;br&gt;　物理・推論・配信は動き続ける&lt;br&gt;&lt;br&gt;再開（resume_sim）は&lt;b&gt;inbox 経由&lt;/b&gt;。直前に積む&lt;br&gt;reload_detector より先に再開すると、&lt;br&gt;古い認識器のまま 1 ステップ進んでしまう&lt;br&gt;（止めるのは即座、再開は順序つき）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="60" y="580" width="360" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="p4-an2" value="&lt;b&gt;マップ切替・介入・パラメータ変更もこの入口から入る&lt;/b&gt;&lt;br&gt;_inbox に積まれたものを&lt;b&gt;ステップ境界&lt;/b&gt;でだけ処理するので、物理や学習の途中に割り込まない。&lt;br&gt;&lt;br&gt;モデルの保存・読込・リセットも同じ（asyncio 側から state_dict() を直接取ると、optimizer.step() の途中の中途半端な重みを掴む）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="60" y="870" width="360" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p4-an3" value="&lt;b&gt;認識器の学習中は load_map を受け付けない&lt;/b&gt;&lt;br&gt;ジョブは開始時に借りた MapIndex を握り続けるので、通すと「収集は元のエリア・画面は新しいエリア」になる。&lt;br&gt;&lt;br&gt;&lt;b&gt;env.apply_params() の台数判定は world.active_count と比べる&lt;/b&gt;&lt;br&gt;self.params.vehicle_count と比べると、3D 画面のクリックで増えた台数がスライダー値と食い違ったまま固定される。&lt;br&gt;歩行者の人数（pedestrianCount）も同じ経路で反映する" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1040" width="360" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p4-an4" value="&lt;b&gt;1 ステップの実測（この PC・8 台・全車が経路追従）&lt;/b&gt;&lt;br&gt;&lt;br&gt;　　　　　　　　　　歩行者 0 / 16 / 64 人&lt;br&gt;銀座・真値　　　　 6.5 / 8.1 / 9.9 ms&lt;br&gt;銀座・CNN 認識　 &lt;b&gt;50.1 / 48.4 / 49.7 ms&lt;/b&gt;&lt;br&gt;金沢・真値　　　　10.4 / 12.7 / 14.0 ms&lt;br&gt;金沢・CNN 認識　 &lt;b&gt;50.2 / 44.0 / 46.1 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;予算は 50ms。認識器を載せるとほぼ使い切る&lt;/b&gt;（内訳は擬似カメラ 16ms ＋ CNN 推論 48ms。&lt;br&gt;マップの規模にはほとんど依存しない）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1270" width="360" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="p4-lb" value="engine._step_once()　1 ステップ ＝ 50ms（等倍）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#072711;" vertex="1" parent="1">
                    <mxGeometry x="480" y="100" width="620" height="1460" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b0" value="&lt;b&gt;⓪ 徒歩キャラの寿命&lt;/b&gt;（実用モードのみ）&lt;br&gt;player_pose が PLAYER_POSE_TTL_SEC（1 秒）届かなければ街から消す。&lt;br&gt;&lt;i&gt;タブを閉じた利用者を残すと、見えない人の前で車が永久に止まる&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="150" width="580" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b1" value="&lt;b&gt;①&lt;/b&gt; obs = env.observations（8 × &lt;b&gt;66&lt;/b&gt;）　active = env.active_mask（8）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="226" width="580" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b2" value="&lt;b&gt;② trainer.act(obs, active)&lt;/b&gt; 方策の推論&lt;br&gt;ActorCritic.act()：torch.no_grad ・ 対角ガウス分布からサンプルし、行動を [-1, 1] へ clip。&lt;br&gt;&lt;b&gt;分布の平均は tanh で -1..1 に収める&lt;/b&gt;（入れないと、環境から見て区別のつかない方向へ平均だけが遠ざかり、二度と戻れなくなる）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="280" width="580" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b3" value="&lt;b&gt;③ result = env.step(actions)&lt;/b&gt; → 右のレーンへ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="380" width="580" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b4" value="&lt;b&gt;④ 実用モードならここで打ち切る&lt;/b&gt;（practical_mode）&lt;br&gt;経験を貯めず、勾配も流さない。&lt;b&gt;物理・推論・配信は動き続ける&lt;/b&gt;ので、学習済みの重みで走り続ける" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="434" width="580" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b5" value="&lt;b&gt;⑤ trainer.store(...) → maybe_update(...)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="500" y="500" width="580" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b5a" value="&lt;b&gt;バッファ未満杯&lt;/b&gt; → None を返す（何もしない）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;fontColor=#072711;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="514" y="534" width="552" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b5b" value="&lt;b&gt;満杯 → _begin_update()&lt;/b&gt;&lt;br&gt;・最終観測から last_values を算出&lt;br&gt;・buffer.compute_returns_and_advantages() GAE(λ)&lt;br&gt;・アドバンテージを正規化し、ミニバッチの順番を決める" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;fontColor=#072711;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="514" y="574" width="552" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b5c" value="&lt;b&gt;_run_pending(budget = PPO_MINIBATCHES_PER_STEP = 1)&lt;/b&gt;&lt;br&gt;1 ミニバッチ ＝ forward → loss（policy + value + entropy）→ backward → step&lt;br&gt;＝ 1 回の PPO 更新を&lt;b&gt;16 ステップに分散&lt;/b&gt;（まとめると数百 ms 止まる）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;fontColor=#072711;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="514" y="684" width="552" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b6" value="&lt;b&gt;⑥ 自動保存&lt;/b&gt;　更新が完了し、かつ trainer.updates - _last_autosave_updates ≧ 20 なら&lt;br&gt;trainer.save(data/checkpoints/shared_policy.pt)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="806" width="580" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b7" value="&lt;b&gt;⑦ 学習指標（1Hz ＝ METRICS_HZ）&lt;/b&gt;&lt;br&gt;_build_metrics() と trainer.network_snapshot() を作り、Lock 内で差し替える。&lt;br&gt;&lt;b&gt;歩行者との衝突率&lt;/b&gt;（pedestrianCollisionRate）もここで数える" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="874" width="580" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b8" value="&lt;b&gt;⑧ 実用モードなら taxi.update(env)&lt;/b&gt;（→ ページ 9）&lt;br&gt;到着判定・ETA の再計算・&lt;b&gt;迎車の引き継ぎ&lt;/b&gt;。配信は&lt;b&gt;段階か車両番号が変わったときと 1Hz&lt;/b&gt;&lt;br&gt;&lt;i&gt;車両番号も契機に入れないと、引き継ぎで車が変わっても最大 1 秒古い車を追いかける&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="952" width="580" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p4-b9" value="&lt;b&gt;⑨ 描画用フレームの生成（FRAME_HZ = 60 で頭打ち）&lt;/b&gt;&lt;br&gt;前回から 1/60 秒経っていない、または render_paused なら&lt;b&gt;ここで return&lt;/b&gt;（フレームを作らない）。&lt;br&gt;作るときは world.snapshot(...) ＋ 認識結果（detections）＋ 天候（weather）＋&lt;b&gt;歩行者（pedestrians）&lt;/b&gt;。&lt;br&gt;経路は&lt;b&gt;変わったスロットだけ&lt;/b&gt;含める（route_revision）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="1030" width="580" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4-bn1" value="&lt;b&gt;描画用フレームを物理の刻みと同じ速さで作らない&lt;/b&gt;&lt;br&gt;8 倍速では物理が毎秒 160 ステップ進むが、配信側のポーリングは 60Hz なので、同じ速さで作ると 6 割以上が配信されずに捨てられる。&lt;br&gt;&lt;br&gt;&lt;b&gt;PPO 更新を 1 ステップにまとめて実行しない&lt;/b&gt;&lt;br&gt;64 台時代の計測で、まとめて回すと 1 回あたり約 350ms ＝ 7 フレームぶん配信が止まり、描画が周期的に固まった。&lt;br&gt;ミニバッチ 1 個ずつに割ると、1 ステップあたりの増分は数 ms に収まる。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="500" y="1140" width="580" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p4-bn2" value="&lt;b&gt;開発モードでは autopilot_all を必ず False に戻す&lt;/b&gt;&lt;br&gt;実用モードの間は街の車も含めて全車が経路追従で走る（止まったままだと道を塞いでタクシーが来られない）。&lt;br&gt;&lt;b&gt;戻し忘れると PPO から見た環境が変わる&lt;/b&gt;——「追突しない世界」「歩行者を轢かない世界」で学習してしまう。&lt;br&gt;&lt;br&gt;同じ理由で、車間（_lead_gap）と歩行者の間合い（_pedestrian_gap）は&lt;b&gt;経路追従の車にだけ&lt;/b&gt;掛ける。&lt;br&gt;PPO 側は観測（歩行者の欄と走行可能領域）から自分で止まれるようになる。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="500" y="1340" width="580" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p4-lc" value="SimulationEnv.step()　内部の実行順（sim/env.py）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#072711;" vertex="1" parent="1">
                    <mxGeometry x="1140" y="100" width="660" height="1460" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c1" value="&lt;b&gt;1&lt;/b&gt; 経路追従で走らせる車を決める（_autopilot_slots）&lt;br&gt;実用モードなら&lt;b&gt;全車&lt;/b&gt;、開発モードなら徴用中の 1 台だけ。&lt;br&gt;その車の accel / steer は Pure Pursuit（δ = atan(L·2sinα/d)）で作る" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="150" width="620" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c2" value="&lt;b&gt;2 world.advance_time(DT = 1/20)&lt;/b&gt;&lt;br&gt;sim_time → signal_phases を作り直す → &lt;b&gt;crowd.step(dt, phases)&lt;/b&gt;（歩行者を進める）&lt;br&gt;2 秒ごとに crowd.recycle()（誰にも見えていない歩行者を車の近くへ回す）&lt;br&gt;&lt;i&gt;★ 現示を作り直した&lt;b&gt;あと&lt;/b&gt;に渡すこと。1 ステップ古い色で渡らせない&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="226" width="620" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c3" value="&lt;b&gt;3&lt;/b&gt; update_yellow_commitment()：黄で「行くと決めた」車を覚える（停止線に近すぎて止まれない車を通す）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="320" width="620" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c4" value="&lt;b&gt;4 速度上限を積む&lt;/b&gt;（すべて fleet.step() より&lt;b&gt;前&lt;/b&gt;）&lt;br&gt;curve_speed_limits()　曲率から「曲がる前に減速」&lt;br&gt;obeySignals なら signal_speed_limits()、obeySpeedSigns なら posted_speed_limits()&lt;br&gt;stop_speed_limits()　乗降地点で止める（赤信号と同じ式）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="378" width="620" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c5" value="&lt;b&gt;5 経路追従の車だけ&lt;/b&gt;さらに絞る&lt;br&gt;_lead_gap()　同じ向きに走っている&lt;b&gt;前方 45m 以内&lt;/b&gt;の車だけを前走車と見なす&lt;br&gt;　（交差する流れまで数えると、互いに相手の前に居座って双方が永久に止まる）&lt;br&gt;_pedestrian_gap()　前方 30m・横 2m の歩行者。&lt;b&gt;4.5m 手前で止まる&lt;/b&gt;&lt;br&gt;　見る相手は world.pedestrian_xy（&lt;b&gt;NPC 群衆と利用者の徒歩キャラの両方&lt;/b&gt;）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="472" width="620" height="94" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c6" value="&lt;b&gt;6&lt;/b&gt; constrain_accel()　指令加速度を速度上限内に丸める" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="580" width="620" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c7" value="&lt;b&gt;7 world.set_braking(accel_cmd)&lt;/b&gt;　制動灯とペダルの踏み込みを&lt;b&gt;同じ指令から&lt;/b&gt;出す&lt;br&gt;&lt;i&gt;実測の加速度から出すと、エンジンブレーキや空気抵抗で減速しただけでも点く&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="628" width="620" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c8" value="&lt;b&gt;8 world.fleet.step(accel_cmd, steer_cmd, DT, max_speed)&lt;/b&gt;&lt;br&gt;キネマティック自転車モデル（numpy で 8 台一括更新）。全台同一諸元（config.VEHICLE_*）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="694" width="620" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c9" value="&lt;b&gt;9&lt;/b&gt; delta = world.project_all()　経路への射影（弧長・横偏差を更新）&lt;br&gt;&lt;b&gt;10&lt;/b&gt; world.update_turn_signals()　経路の 30m 先の接線との差で方向指示器を決める&lt;br&gt;　（出す 0.35rad / 消す 0.12rad の&lt;b&gt;ヒステリシス&lt;/b&gt;。片側だけだと緩いカーブで点滅する）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="760" width="620" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c10" value="&lt;b&gt;11 終了条件の評価（すべて真値で判定する）&lt;/b&gt;&lt;br&gt;collided ＝ world.check_collisions()：建物（占有グリッド）／車両どうし／障害物／&lt;b&gt;歩行者&lt;/b&gt;の 4 種&lt;br&gt;　歩行者との接触だけ pedestrian_hits にも残す（学習タブで分けて出すため）&lt;br&gt;offroad ＝ |横偏差| ≧ OFFROAD_LIMIT　　reached ＝ 目的地まで GOAL_RADIUS 以内&lt;br&gt;timeout ＝ episode_steps ≧ MAX_EPISODE_STEPS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="840" width="620" height="94" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c11" value="&lt;b&gt;12&lt;/b&gt; ran_red ＝ world.signal_violations()　over_speed ＝ world.speed_violations()&lt;br&gt;world.update_lane_departures()（車線逸脱の回数と平均のずれ）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="948" width="620" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c12" value="&lt;b&gt;13 報酬の計算&lt;/b&gt;（active_before でマスク。set_params で実行中に変更できる）&lt;br&gt;reward_progress × delta ＝ &lt;b&gt;+1.0 / m&lt;/b&gt;（弧長の伸びに比例）&lt;br&gt;＋ reward_time（毎ステップの小さな負）／ reward_goal（到達）&lt;br&gt;－ 衝突 / 逸脱 / 信号無視 / 速度超過&lt;br&gt;&lt;i&gt;★ 観測は濁っても（霧・誤認識）、報酬と終了条件は真値のまま&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="1014" width="620" height="94" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c13" value="&lt;b&gt;14&lt;/b&gt; dones ＝ (reached | collided | offroad | timeout) &amp;amp; active_before&lt;br&gt;&lt;b&gt;徴用中の 1 台はここで閉じない&lt;/b&gt;（dones[held] = False）。閉じると乗降地点に着いた瞬間に&lt;br&gt;respawn し、乗客を置いて別の街区へ飛ぶ&lt;br&gt;終了スロットは EpisodeResult を積み、同じ step の中で try_respawn()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="1122" width="620" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4-c14" value="&lt;b&gt;15 self._obs = env._compute_observations()&lt;/b&gt;（→ ページ 5）&lt;br&gt;アクティブなスロットだけ擬似カメラを描き、CNN 推論 → encoder で 66 次元へ。&lt;br&gt;&lt;b&gt;推論が落ちたら認識器を手放す&lt;/b&gt;（握ったままだと、真値で走っているのに画面は&lt;br&gt;「CNN の認識結果」のままになり、毎ステップ描画と推論を試み続けて遅くなる）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="1216" width="620" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p4-cn1" value="&lt;b&gt;全車を経路追従にしたことで表に出た、シミュレータ側の壊れ 3 つ&lt;/b&gt;（どれも実用モード固有ではない）&lt;br&gt;&lt;br&gt;&lt;b&gt;map/index.py signals_on_route()&lt;/b&gt;　同じ交差点の灯器が別ノードに 2 基あると、現示は node_id から&lt;br&gt;　オフセットを決めるので片方が青でも片方が赤になり、車は永久に動けない → 8m 以内は 1 基へまとめる&lt;br&gt;&lt;b&gt;world._forward_node()&lt;/b&gt;　真横や足元のノードを選ぶと経路がその場から直角に始まる。最大舵角でも&lt;br&gt;　旋回半径は 4.4m あるので曲がりきれない → 14m 以上・±60° の錐から選ぶ&lt;br&gt;&lt;b&gt;world._random_route()&lt;/b&gt;　再配置の始点が他車のすぐ前だと、走ってきた車が次の瞬間に追突する →&lt;br&gt;　クリアランスを車 4 台分に広げ、空いた始点が無ければ&lt;b&gt;いちばん空いている候補&lt;/b&gt;を返す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="1316" width="620" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p4-ld" value="定数・配信・注意点" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FDF6F0;strokeColor=#B3541E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#3E1C00;" vertex="1" parent="1">
                    <mxGeometry x="1840" y="100" width="460" height="1460" as="geometry"/>
                </mxCell>
                <mxCell id="p4-d1" value="&lt;b&gt;観測 OBS_DIM = 66 の内訳&lt;/b&gt;&lt;br&gt;（config.py が定義し、percep/encoder.py が組み立てる）&lt;br&gt;&lt;br&gt;&lt;b&gt;カメラ認識から&lt;/b&gt;&lt;br&gt;　車線 4 ／ 信号 5 ／ 標識 3&lt;br&gt;　前方車両 12（3 台 × 4）&lt;br&gt;　障害物 9（3 個 × 3）&lt;br&gt;　&lt;b&gt;歩行者 9（3 人 × 3）&lt;/b&gt;&lt;br&gt;　走行可能領域 9（9 方向）&lt;br&gt;&lt;b&gt;センサーとナビから（真値）&lt;/b&gt;&lt;br&gt;　自車 2 ／ 目的地 3 ／ 経路先読み 10（5 点 × 2）&lt;br&gt;&lt;br&gt;&lt;i&gt;50 → 54 → 56 → 57 → 66 と変えてきた。&lt;br&gt;変えると過去のモデルは読めなくなる&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="150" width="420" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="p4-d2" value="&lt;b&gt;PPO の設定&lt;/b&gt;（config.py）&lt;br&gt;PPO_HIDDEN_SIZES = (128, 128)&lt;br&gt;※実行中に set_network で 1〜4 層・幅 16〜512 に変更できる（作り直しになる）&lt;br&gt;ROLLOUT_STEPS ／ PPO_EPOCHS ／ PPO_MINIBATCHES&lt;br&gt;PPO_MINIBATCHES_PER_STEP = 1&lt;br&gt;MAX_VEHICLES = 8 ／ MAX_PEDESTRIANS = 64&lt;br&gt;DT = 0.05（20Hz）／ FRAME_HZ = 60 ／ METRICS_HZ = 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="436" width="420" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p4-d3" value="&lt;b&gt;asyncio 側 broadcast_loop()（60Hz ポーリング）&lt;/b&gt;&lt;br&gt;・take_frame() が新しい frame を返したら配信&lt;br&gt;　（render_paused の間は None が返る）&lt;br&gt;・metrics / network / detector は 1Hz&lt;br&gt;・&lt;b&gt;taxi は段階か車両番号が変わったときと 1Hz&lt;/b&gt;&lt;br&gt;・params / status は変化時&lt;br&gt;・_notices を拾って status.message として流す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="612" width="420" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p4-d4" value="&lt;b&gt;方策が「止まる」に固まるのを防ぐ&lt;/b&gt;&lt;br&gt;&lt;br&gt;行動分布の平均は&lt;b&gt;必ず tanh で -1..1 に収める&lt;/b&gt;。&lt;br&gt;act() は clip してから環境へ渡すので、&lt;b&gt;環境から見ると平均が -1 でも -3 でも同じ&lt;/b&gt;（どちらもフルブレーキ）。&lt;br&gt;制約が無いと、区別のつかない方向へ勾配が流れても損失は下がり、平均だけが範囲の外へ遠ざかる。&lt;br&gt;&lt;br&gt;&lt;b&gt;報酬設計は無実だった&lt;/b&gt;：同じ状況で経路追従なら 60 秒で +168.5、止まったままなら -60.0。&lt;br&gt;&lt;b&gt;罰の重さを疑う前に、平均が範囲の中にいるかを見る。&lt;/b&gt;&lt;br&gt;&lt;br&gt;固まった重みは warmstart_policy.py で立て直す（方策・&lt;b&gt;価値関数&lt;/b&gt;・探索ノイズの&lt;b&gt;3 つセット&lt;/b&gt;）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="788" width="420" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="p4-d5" value="&lt;b&gt;試して駄目だったこと&lt;/b&gt;（同じ検討を繰り返さないための記録）&lt;br&gt;・entropy_coef = 0.01：行動が 2 次元・[-1, 1] しかないこの問題では探索が広がりすぎて、車線を外れる方向に効いた&lt;br&gt;・カーブでブレーキまで踏ませる：金沢の衝突は 2 → 1 回になるが、&lt;b&gt;銀座が 0 → 2 回に悪化&lt;/b&gt;（交差点の中で止まってしまう）&lt;br&gt;・探索ノイズを 0.15 まで絞る：衝突は止まるが学習の伸びが鈍り、エントロピーが張り付いて「動いていない」ように見える（0.3〜0.4 が釣り合う）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="1064" width="420" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p4-d6" value="&lt;b&gt;既知の弱点&lt;/b&gt;&lt;br&gt;・全交差点に信号を置いたため、連続する信号の間隔が詰まる区間がある&lt;br&gt;・金沢は「経路の 80% が物理的に到達不能」（無作為な 2 点が平均 6km 離れるのに、1 エピソードでは 2,780m しか進めない）。学習題材は銀座が既定&lt;br&gt;・金沢では 200 秒・8 台あたり 2 回ほど車どうしの接触が残る（銀座は 0 回）。原因は経路生成側（建物を貫く経路・旋回半径より急な曲率）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1860" y="1300" width="420" height="216" as="geometry"/>
                </mxCell>
                <mxCell id="p4-y1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-a1" target="p4-a2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-y2" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A88400;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p4-a2" target="p4-a3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-y3" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p4-a3" target="p4-a4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-y4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-a4" target="p4-a5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-y5" value="次のステップへ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-a5" target="p4-a1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="30" y="512"/>
                            <mxPoint x="30" y="181"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4-y6" value="呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-a4" target="p4-b0">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-y7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-b3" target="p4-c1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-y7l" value="呼び出し" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="p4-y7">
                    <mxGeometry x="-0.2" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4-y8" value="StepResult（obs / rewards / dones / active / episodes）を返す" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-c14" target="p4-b4">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1816" y="1256"/>
                            <mxPoint x="1816" y="460"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p4-y9" value="_latest_frame / _metrics / _network / _taxi（Lock 保護）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A88400;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4-b9" target="p4-d3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-percep" name="5. 観測が作られる経路（擬似カメラ → CNN → 66 次元）">
        <mxGraphModel dx="2339" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5-title" value="5. 観測が作られる経路（擬似カメラ → CNN → 66 次元）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1D1B20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p5-sub" value="&lt;b&gt;車両は擬似カメラ画像を CNN で認識した結果だけを見て走る。&lt;/b&gt;ここが一番間違えやすい。&lt;b&gt;観測はカメラ由来、報酬と終了条件は真値由来&lt;/b&gt;——霧で赤信号を見落として進めば、そのとおり信号無視として罰が入る。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" vertex="1" parent="1">
                    <mxGeometry x="40" y="58" width="1700" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p5-la" value="毎ステップ（env._compute_observations）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#072711;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="640" height="1120" as="geometry"/>
                </mxCell>
                <mxCell id="p5-w0" value="&lt;b&gt;world（真値）&lt;/b&gt;&lt;br&gt;車両 8 台 ／ 障害物 ／ 歩行者（NPC ＋ 徒歩キャラ）／ 信号の現示 ／ 標識 ／ 車線 ／ 建物" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="150" width="600" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p5-weather" value="&lt;b&gt;percep/weather.py&lt;/b&gt;　天候（雨・霧）&lt;br&gt;&lt;b&gt;視程（visibility_m）はここが唯一の出典&lt;/b&gt;。擬似カメラの描画と正解ラベルの&lt;b&gt;両方&lt;/b&gt;が読む。&lt;br&gt;片方だけ変えると「見えないものにラベルが付く」状態になり、認識器から見てタスクが定義できない" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="234" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p5-cam" value="&lt;b&gt;percep/camera.py&lt;/b&gt;　擬似カメラ 192×144 を numpy で描く（運転席視点）&lt;br&gt;地平線より下を道路ラスタの参照 1 回で塗り、物体は&lt;b&gt;奥から手前へ&lt;/b&gt;矩形／楕円のスパンで重ねる。&lt;br&gt;歩行者は「胴の矩形 ＋ 頭の楕円」。&lt;b&gt;深度バッファは霧のときだけ作る&lt;/b&gt;（晴れ・雨では描画コストが増えない）&lt;br&gt;&lt;i&gt;実測：晴れ 9.7ms / 雨 13.0ms / 霧 14.5ms（銀座・8 台ぶんまとめて）&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="332" width="600" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="p5-det" value="&lt;b&gt;percep/detector.py&lt;/b&gt;　CNN（Keras 3 / torch バックエンド。&lt;b&gt;TensorFlow は入れない&lt;/b&gt;）&lt;br&gt;入力直後に Rescaling(1/255) を持つので、&lt;b&gt;画像は uint8 のまま渡す&lt;/b&gt;&lt;br&gt;出力は 6×8 のセルごとのクラス・箱・距離と、&lt;b&gt;走行可能領域（freespace）9 方向&lt;/b&gt;&lt;br&gt;&lt;i&gt;実測：1 ステップあたり 48ms（8 台ぶんを 1 バッチ）。ここが全体の支配項&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="444" width="600" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="p5-types" value="&lt;b&gt;検出結果（percep/types.py の Detection）&lt;/b&gt;&lt;br&gt;クラス 6 種：TRAFFIC_LIGHT 0 / SPEED_SIGN 1 / VEHICLE 2 / OBSTACLE 3 / LANE 4 / &lt;b&gt;PEDESTRIAN 5&lt;/b&gt;&lt;br&gt;1 台あたり最大 PERCEP_MAX_DETECTIONS = 15 件。&lt;b&gt;CLASS_QUOTA&lt;/b&gt; で切り詰めても内訳が欠けないようにする&lt;br&gt;　（車線 1 / 信号 2 / 標識 1 / 歩行者 3 / 車両 4 / 障害物 4）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="556" width="600" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="p5-enc" value="&lt;b&gt;percep/encoder.py&lt;/b&gt;　→ 観測 &lt;b&gt;66 次元&lt;/b&gt;&lt;br&gt;カメラ認識から：車線 4 ／ 信号 5 ／ 標識 3 ／ 前方車両 12 ／ 障害物 9 ／ &lt;b&gt;歩行者 9&lt;/b&gt; ／ 走行可能領域 9&lt;br&gt;センサーとナビから（真値）：自車 2 ／ 目的地 3 ／ 経路先読み 10&lt;br&gt;&lt;i&gt;オフセットの出典は encoder.OBS_OFFSETS。書き出したモデルのメタデータにも同じものを埋める&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="668" width="600" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="p5-ppo" value="&lt;b&gt;PPO（rl/）へ&lt;/b&gt;　8 × 66 の観測行列" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="780" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p5-gt" value="&lt;b&gt;percep/groundtruth.py&lt;/b&gt;　真値から作る「理想の検出結果」&lt;br&gt;&lt;br&gt;&lt;b&gt;★ 教師データ兼フォールバックの二役。分けてはいけない。&lt;/b&gt;&lt;br&gt;・認識器が載っていない／推論が落ちたときは、これが同じ形の Detection を返す&lt;br&gt;・認識器を学習するときは、これが正解ラベルになる&lt;br&gt;&lt;br&gt;&lt;b&gt;camera.py と同じものを見ていなければならない&lt;/b&gt;（描いた物体にラベルが付かない、&lt;br&gt;またはその逆だと、認識器から見てタスクが定義できない）。&lt;br&gt;正対判定は types.facing_viewer() に一本化し、投影式・3D 寸法も両者で一致させる" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="856" width="600" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p5-occl" value="&lt;b&gt;遮蔽判定は静的と動的の 2 本立て&lt;/b&gt;&lt;br&gt;_line_of_sight()　占有グリッド（&lt;b&gt;建物レイヤのみ&lt;/b&gt;）へのレイキャスト&lt;br&gt;_blocked_by_fleet()　他車の車体との線分交差&lt;br&gt;&lt;br&gt;&lt;b&gt;後者を掛けるのは車両・障害物・歩行者だけ。&lt;/b&gt;信号・標識には掛けない&lt;br&gt;（車高 1.5m の 2D 判定では、高い位置の灯器や板まで隠してしまう）&lt;br&gt;&lt;br&gt;_STATIC_CACHE は map_index の identity 比較 1 件だけ。&lt;b&gt;複数マップを行き来する&lt;br&gt;コードでは切り替えのたびに clear_static_cache() を呼ぶこと&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1026" width="600" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p5-lb" value="天候（percep/weather.py と scene/weatherView.ts）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EDF3FE;strokeColor=#0B57D0;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#041E49;" vertex="1" parent="1">
                    <mxGeometry x="710" y="100" width="700" height="560" as="geometry"/>
                </mxCell>
                <mxCell id="p5-wt" value="&lt;b&gt;雨と霧は役割が違い、直交している。混ぜない。&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;雨&lt;/b&gt;　画を暗く濁らせ、斜めの筋を乗せる&lt;br&gt;　　視程を&lt;b&gt;縮めない&lt;/b&gt;　／　深度バッファは要らない&lt;br&gt;　　筋は&lt;b&gt;疎な添字&lt;/b&gt;で持つ（密な (H, W) マスクで全画素に掛けると 1 枚 7ms）&lt;br&gt;&lt;br&gt;&lt;b&gt;霧&lt;/b&gt;　距離に応じて白く沈ませる&lt;br&gt;　　視程を&lt;b&gt;縮める&lt;/b&gt;　／　深度バッファが&lt;b&gt;要る&lt;/b&gt;&lt;br&gt;　　groundtruth 側も同じ距離で候補を打ち切る" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="730" y="146" width="660" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p5-w3d" value="&lt;b&gt;3D 側（scene/weatherView.ts）にも同じ天候を描く&lt;/b&gt;&lt;br&gt;擬似カメラだけに掛けると、利用者から見て&lt;b&gt;天候を切り替えても画面が何も変わらない&lt;/b&gt;。&lt;br&gt;&lt;br&gt;・&lt;b&gt;視程をそのまま 3D のフォグにしない&lt;/b&gt;。300m 上空の俯瞰へ適用すると街が 1 つも見えない&lt;br&gt;　真っ暗な画になる → fogLift() が視点の高さで緩める&lt;br&gt;・晴れの遠景フォグ（数 km）と霧（数十 m）は&lt;b&gt;幾何補間&lt;/b&gt;でつなぐ（線形だと桁が違いすぎる）&lt;br&gt;・&lt;b&gt;雨を 3D 空間の粒にしない&lt;/b&gt;。俯瞰では 1 画素にも満たない → カメラ直前の板へシェーダーで描く&lt;br&gt;・画面に出す天候は&lt;b&gt;目標値へ追いつく途中の値&lt;/b&gt;（displayedWeather）。押した瞬間に空と路面が&lt;br&gt;　切り替わると作り物に見えるので 1〜2 秒かけて寄せ、路面はさらに遅く乾かす&lt;br&gt;・進めるのは SceneAtmosphere の 1 か所だけ（useFrame の priority を&lt;b&gt;負&lt;/b&gt;にして最初に走らせる）&lt;br&gt;・濡れた路面で metalness を上げすぎない（環境マップが無いので&lt;b&gt;ただ黒くなるだけ&lt;/b&gt;）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="730" y="342" width="660" height="196" as="geometry"/>
                </mxCell>
                <mxCell id="p5-wauto" value="&lt;b&gt;weather_auto の間、params の weatherRain / weatherFog は更新しない。&lt;/b&gt;&lt;br&gt;いま出ている天候は frame.weather で見ること（docs/protocol.md 2.3）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="730" y="554" width="660" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p5-lc" value="認識結果の見せ方（フロントエンド）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F2FA;strokeColor=#6750A4;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#21005D;" vertex="1" parent="1">
                    <mxGeometry x="710" y="690" width="700" height="530" as="geometry"/>
                </mxCell>
                <mxCell id="p5-ov" value="&lt;b&gt;scene/DetectionOverlay.tsx&lt;/b&gt;（運転席カメラのときだけ出る）&lt;br&gt;frame.detections[スロット番号] を受け、detectionProjection.projectBox() で画面へ写す。&lt;br&gt;&lt;b&gt;擬似カメラ（水平 68 度）と three の運転席カメラ（垂直 95 度）は画角が違う&lt;/b&gt;ので、&lt;br&gt;tan 空間で換算する。位置はずれないが、&lt;b&gt;枠が出るのは画面の中央 34.8% × 46.4% の範囲だけ&lt;/b&gt;&lt;br&gt;（code_review V-04。画角を 68 度に揃えていた頃は 56.3% × 75.0% だった）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="730" y="736" width="660" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p5-lane" value="&lt;b&gt;scene/LaneDetectionOverlay.tsx&lt;/b&gt;　認識した車線を路面へ重ねる（polygonOffset は最前面の -6/-12）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="730" y="858" width="660" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p5-feed" value="&lt;b&gt;scene/TaxiCameraFeed.tsx&lt;/b&gt;（実用モードの車載カメラ）&lt;br&gt;&lt;b&gt;これは擬似カメラではない&lt;/b&gt;——シーンを運転席視点でもう一度描いたもの。&lt;br&gt;検出枠は DetectionOverlay と&lt;b&gt;同じ projectBox()&lt;/b&gt; で写すので、枠の出どころは 1 つ。&lt;br&gt;・オフスクリーン（WebGLRenderTarget）へ描く。画面の一部を借りると、そこを&lt;br&gt;　元の視点で描き直すためにシーンをもう一度走査することになる&lt;br&gt;・レンダーターゲットの既定はメインの画と&lt;b&gt;揃っていない&lt;/b&gt;。3 つとも明示する：&lt;br&gt;　解像度（表示の実寸 × dpr）／ samples: 4 ／ texture.colorSpace = SRGBColorSpace&lt;br&gt;・転送は 15fps に絞る（readRenderTargetPixels は GPU → CPU の&lt;b&gt;同期&lt;/b&gt;転送）&lt;br&gt;・転送先のキャンバスは&lt;b&gt;借りたら必ず返す&lt;/b&gt;（返さないと畳んだ裏で描き続ける）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="730" y="918" width="660" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p5-stat" value="&lt;b&gt;「観測の出どころ」の表示&lt;/b&gt;　status.detectorActive（1Hz で取り直す）&lt;br&gt;認識器が載っていれば「CNN の認識結果」、そうでなければ「真値」。&lt;br&gt;&lt;b&gt;推論が落ちたら認識器を手放す&lt;/b&gt;ので、この表示も自動で「真値」へ戻る" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="730" y="1084" width="660" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p5-ld" value="認識器の学習（CLI と「モデル作成」タブが同じ関数を呼ぶ）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FDF6F0;strokeColor=#B3541E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#3E1C00;" vertex="1" parent="1">
                    <mxGeometry x="1440" y="100" width="860" height="1120" as="geometry"/>
                </mxCell>
                <mxCell id="p5-t0" value="&lt;b&gt;アルゴリズムは必ず percep/trainer.py へ書く。&lt;/b&gt;&lt;br&gt;CLI（train_detector.py）と Web UI（runtime/detector_job.py →「モデル作成」タブ）が&lt;b&gt;同じ関数&lt;/b&gt;を呼ぶ。&lt;br&gt;片方にだけ足すと「コマンドでは学習できるのに画面からだと違う」という切り分け不能な食い違いになる。&lt;br&gt;値域（枚数・エポック・バッチ・倍率・乱数種）は &lt;b&gt;runtime/detector_job.py の定数が唯一の出典&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1460" y="146" width="820" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5-t1" value="&lt;b&gt;① 採点（percep/evaluate.py）&lt;/b&gt;　⑩ アクティブラーニング&lt;br&gt;いまの認識器を走らせ、真値と突き合わせてクラス別・天候別の成績を出す。&lt;br&gt;&lt;b&gt;その成績がそのまま次の収集の重みになる&lt;/b&gt;（成績が低いほど多く集める）。&lt;br&gt;&lt;b&gt;収集の直前に 1 度だけ走り、走行中のステップには一切乗らない&lt;/b&gt;（50ms の予算を守るため）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1460" y="246" width="820" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5-t2" value="&lt;b&gt;② 収集（collect_dataset）&lt;/b&gt;&lt;br&gt;arrange_scene() で狙うクラスへ寄せ、擬似カメラで撮って groundtruth でラベルを付ける。&lt;br&gt;1 回の render() でアクティブな台数ぶん（既定 8 枚）まとまるので、2,400 枚 ＝ 300 ステップ。&lt;br&gt;&lt;b&gt;散らし直しの周期は「枚数」ではなく「ステップ数」&lt;/b&gt;（_reset_interval が samples から決める）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1460" y="346" width="820" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p5-t3" value="&lt;b&gt;③ 学習（fit_detector）&lt;/b&gt;　Keras 3 / torch。validation_split で val_loss を見る&lt;br&gt;&lt;b&gt;④ 保存&lt;/b&gt;　data/detector/detector.keras ＋ dataset/detector_dataset.npz（DATASET_VERSION = 3）&lt;br&gt;&lt;b&gt;⑤ 載せ替え&lt;/b&gt;　engine へ reload_detector を積む（&lt;b&gt;resume_sim より後&lt;/b&gt;に積むこと）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1460" y="446" width="820" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p5-t4" value="&lt;b&gt;教師データまわりの不変条件（どれも「成績が良くなる方向」に症状が出るので外から気づけない）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;・画像は uint8 のまま学習へ渡す&lt;/b&gt;　build_detector() が入力直後に Rescaling(1/255) を持つ。&lt;br&gt;　学習側で float32 に広げると 4,800 枚で 380MB が 1,519MB になり、&lt;b&gt;出力は 1 ビットも変わらない&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;・collect_dataset は返す直前に全体を並べ替える&lt;/b&gt;　Keras の validation_split は shuffle より&lt;b&gt;前に末尾から&lt;/b&gt;&lt;br&gt;　切り出すので、時系列順のまま渡すと検証データが「収集の最後の 1.5 秒ぶんの画」になる。&lt;br&gt;　20Hz の連続フレームは隣同士がほぼ同じなので、&lt;b&gt;学習データとほぼ重複する&lt;/b&gt;（val_loss が実力より低く出る）&lt;br&gt;&lt;br&gt;&lt;b&gt;・弱点を狙わない（class_focus が空の）ときは、狙うクラスを選ばない&lt;/b&gt;　一様に選ぶと信号・標識狙いの&lt;br&gt;　寄せが毎回 1/5 で走り、似た構図ばかりになって過学習する（実測：銀座 1,600 枚 12 エポックで&lt;br&gt;　val_loss が学習損失の 50 倍、検出率 9.3%）&lt;br&gt;&lt;br&gt;&lt;b&gt;・弱点を狙う強さ（evaluate.FOCUS_GAIN）を上げすぎない&lt;/b&gt;　3.0 で回すと霧は 11.5% → 65.4% になる&lt;br&gt;　代わりに&lt;b&gt;晴れが 79.4% → 63.0% へ落ちた&lt;/b&gt;（2,400 枚のうち晴れが 304 枚しか残らないため）。1.5 が釣り合う&lt;br&gt;&lt;br&gt;&lt;b&gt;・パイロンと歩行者は scatter_props() の 1 本から置き直す&lt;/b&gt;　別々に呼べるようにしておくと、片方だけ&lt;br&gt;　呼ぶ経路がいつか生まれ、狙ったクラスが薄いまま集まる&lt;br&gt;&lt;br&gt;&lt;b&gt;・歩行者は街へ一様に撒かない&lt;/b&gt;　金沢は 12.3km 四方なので、64 人を一様に散らすと 1 枚の画に 1 人も&lt;br&gt;　写らない（実測で真値 0 件）。走っている車の周りへ寄せる。&lt;b&gt;ただし寄せる範囲を狭めすぎない&lt;/b&gt;&lt;br&gt;　（26m に寄せたら歩行者が他クラスを押しのけ、車両 234 → 163 件に減った）。既定は 115m&lt;br&gt;&lt;br&gt;&lt;b&gt;・パイロンを濃く置くかどうかを決めるのは scatter_obstacles(focus=...) の中だけ&lt;/b&gt;　呼び出し側で組み立てると、&lt;br&gt;　散らし直しが&lt;b&gt;狙いを知らないまま素に戻す&lt;/b&gt;（実測で 600 ステップ中 278 ステップが薄いままだった）&lt;br&gt;&lt;br&gt;&lt;b&gt;・認識器の学習中は load_map を受け付けない&lt;/b&gt;　ジョブは開始時に借りた MapIndex を握り続ける" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="1460" y="536" width="820" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="p5-t5" value="&lt;b&gt;DATASET_VERSION は「中身の意味を変えたら上げる」&lt;/b&gt;（1 → 2 は weather 列を足したとき、2 → 3 は歩行者クラスを足して検出チャンネル数が 23 → 24 になったとき）。&lt;br&gt;無かった頃は、チャンネル数だけが変わったときに損失が&lt;b&gt;縮んだスライスを黙って受け取り&lt;/b&gt;、「学習は最後まで走ったのに、まったく検出しないモデルができる」という失敗をした" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1460" y="1076" width="820" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="p5-foot" value="&lt;b&gt;★ 失敗を黙って握りつぶさない&lt;/b&gt;　認識・衝突・規制速度の判定は、失敗すると&lt;b&gt;成績が良くなる方向&lt;/b&gt;へ倒れる（「前方はすべて空いている」「遮蔽は無い」「衝突していない」「規制速度は不明」）。&lt;br&gt;groundtruth.py・map/index.py・percep/weather.py の _warn_once() が初回だけ記録する。&lt;b&gt;新しく例外を握りつぶすときは必ず同じ形にすること。&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1250" width="2260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-w0" target="p5-weather">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e2" value="視程" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5-weather" target="p5-cam">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e3" value="画像（uint8 192×144×3）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5-cam" target="p5-det">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-det" target="p5-types">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-types" target="p5-enc">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-enc" target="p5-ppo">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p5-e7" value="認識器が無い／推論が落ちたとき" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3541E;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5-gt" target="p5-types">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="690" y="894"/>
                            <mxPoint x="690" y="598"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p5-e8" value="正解ラベル" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3541E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5-gt" target="p5-t2">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1420" y="968"/>
                            <mxPoint x="1420" y="386"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p5-e9" value="detector.keras を載せ替える" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3541E;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5-t3" target="p5-det">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1430" y="481"/>
                            <mxPoint x="1430" y="700"/>
                            <mxPoint x="700" y="700"/>
                            <mxPoint x="700" y="486"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p5-e10" value="detections（frame）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p5-types" target="p5-ov">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="690" y="598"/>
                            <mxPoint x="690" y="789"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-proto" name="6. 配信プロトコルと描画パイプライン">
        <mxGraphModel dx="1654" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1560" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p6-title" value="6. 配信プロトコル（サーバー → クライアント）と描画パイプライン" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1D1B20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="20" width="1200" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p6-sub" value="docs/protocol.md（&lt;b&gt;protocolVersion = 2&lt;/b&gt;）がフロント／バック間の唯一の契約。メッセージのフィールド名は camelCase、内部は snake_case で、変換は contracts.py の to_wire() に閉じ込める。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" vertex="1" parent="1">
                    <mxGeometry x="40" y="58" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p6-lm" value="サーバー → クライアント（全 11 種）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EDF3FE;strokeColor=#0B57D0;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#041E49;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="420" height="1040" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m1" value="&lt;b&gt;init&lt;/b&gt;　接続確立直後に 1 回だけ&lt;br&gt;protocolVersion（= 2）/ presets[] /&lt;br&gt;config{maxVehicles, maxPedestrians, simHz, obsDim, actionDim} / params / status" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="146" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m2" value="&lt;b&gt;map&lt;/b&gt;　マップ読込完了時（低頻度・大サイズ）&lt;br&gt;presetId / name / bounds / nodes[] / edges[] /&lt;br&gt;buildings[] / signals[] / signs[]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="226" width="380" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m3" value="&lt;b&gt;frame&lt;/b&gt;　等倍 20Hz（最大 60Hz で頭打ち）&lt;br&gt;tick / simTime&lt;br&gt;&lt;b&gt;vehicles[]&lt;/b&gt; ※常に maxVehicles 件&lt;br&gt;　id, active, x, y, heading, speed, steer,&lt;br&gt;　collided, reachedGoal, speedLimit, …&lt;br&gt;　&lt;b&gt;braking / throttle / turnSignal&lt;/b&gt;（灯火とペダル）&lt;br&gt;　route[]（&lt;b&gt;変わったスロットだけ&lt;/b&gt;）&lt;br&gt;obstacles[] ／ &lt;b&gt;pedestrians[]&lt;/b&gt;（0 人なら省略）&lt;br&gt;signals[]（map.signals と同じ並び）&lt;br&gt;&lt;b&gt;detections{}&lt;/b&gt;（キーはスロット番号の文字列）&lt;br&gt;&lt;b&gt;weather&lt;/b&gt;{rain, fog, visibility}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="298" width="380" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m4" value="&lt;b&gt;status&lt;/b&gt;　状態変化時（不定期）&lt;br&gt;state（idle / loading_map / running / error）&lt;br&gt;mapLoaded / presetId / renderPaused / learning&lt;br&gt;simSuspended / &lt;b&gt;practicalMode&lt;/b&gt; / detectorActive / message" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="478" width="380" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m5" value="&lt;b&gt;params&lt;/b&gt;　パラメータが反映されたとき&lt;br&gt;vehicleCount / &lt;b&gt;pedestrianCount&lt;/b&gt; / simSpeed /&lt;br&gt;learningRate / gamma / clipRange / 報酬の重み /&lt;br&gt;weatherRain / weatherFog / weatherAuto …" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="560" width="380" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m6" value="&lt;b&gt;metrics&lt;/b&gt;　1Hz（METRICS_HZ）&lt;br&gt;updates / episodes / meanEpisodeReward /&lt;br&gt;policyLoss / valueLoss / entropy / approxKl /&lt;br&gt;collisionRate ／ &lt;b&gt;pedestrianCollisionRate&lt;/b&gt; /&lt;br&gt;goalRate / stepsPerSec / laneDeviation …" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="642" width="380" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m7" value="&lt;b&gt;network&lt;/b&gt;　1Hz（metrics と同間隔）&lt;br&gt;updates / obsDim（= 66）/ actionDim /&lt;br&gt;hiddenSizes[] / layers[]{ name, role, shape, … }" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="738" width="380" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m8" value="&lt;b&gt;detector&lt;/b&gt;　認識器の学習中だけ 1Hz（進捗が動いたときのみ）&lt;br&gt;state（idle / preparing / collecting / training / saving / done / failed / cancelled）/ progress / request" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="810" width="380" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m9" value="&lt;b&gt;taxi&lt;/b&gt;　実用モードの配車（段階か&lt;b&gt;車両番号&lt;/b&gt;が変わったときと 1Hz）&lt;br&gt;phase（idle / approaching / waiting / riding / arrived）&lt;br&gt;vehicleId / pickup / dropoff / route[] / routeRevision /&lt;br&gt;etaSeconds / remainingDistanceM / message" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="882" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m10" value="&lt;b&gt;error&lt;/b&gt;　異常時（不定期）&lt;br&gt;code: MAP_LOAD_FAILED / INVALID_MESSAGE /&lt;br&gt;NO_MAP_LOADED / SPAWN_FAILED / INTERNAL" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="972" width="380" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p6-m11" value="&lt;b&gt;pong&lt;/b&gt;　ping への応答（t: epoch ms）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1044" width="380" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p6-mnote" value="&lt;b&gt;省略されたフィールドは「前回値を保持」&lt;/b&gt;（route / detections / weather）。未知の type は default で無視する（前方互換）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1090" width="380" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p6-lr" value="フロントエンドの受け口" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F2FA;strokeColor=#6750A4;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#21005D;" vertex="1" parent="1">
                    <mxGeometry x="480" y="100" width="700" height="1040" as="geometry"/>
                </mxCell>
                <mxCell id="p6-n1" value="&lt;b&gt;store/connection.ts handleRaw()&lt;/b&gt;&lt;br&gt;JSON パース → type の存在チェック（&lt;b&gt;唯一の入口&lt;/b&gt;）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="290" width="280" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p6-n2" value="&lt;b&gt;simStore.applyServerMessage(msg)&lt;/b&gt;&lt;br&gt;switch (msg.type) で振り分ける" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="500" y="386" width="280" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p6-r1" value="&lt;b&gt;store/frameBuffer.ts&lt;/b&gt;（React の外・可変オブジェクト）&lt;br&gt;pushFrame(msg) が入れるもの：&lt;br&gt;・prev / curr / prevTime / currTime（補間用の 2 枚）&lt;br&gt;・routes（スロットごと）と routeRevisions&lt;br&gt;・signals と signalVersion&lt;br&gt;・obstacles と obstacleVersion&lt;br&gt;・&lt;b&gt;pedestrians&lt;/b&gt;（prev / curr の両方）&lt;br&gt;・&lt;b&gt;weather&lt;/b&gt;（rain / fog / visibility）&lt;br&gt;・detections（スロットごと）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="820" y="146" width="340" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p6-r3" value="&lt;b&gt;frameBuffer を直接読む消費者&lt;/b&gt;（zustand を経由しない）&lt;br&gt;Vehicles / CameraRig / RouteLines / TrafficSignals /&lt;br&gt;PedestrianSignals / Obstacles / &lt;b&gt;NpcPedestrians&lt;/b&gt; /&lt;br&gt;&lt;b&gt;NavScreen&lt;/b&gt; / &lt;b&gt;TaxiCameraFeed&lt;/b&gt; / &lt;b&gt;Pedestrian&lt;/b&gt; /&lt;br&gt;DetectionOverlay / LaneDetectionOverlay / Rain / TaxiMap" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="820" y="344" width="340" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p6-r2" value="&lt;b&gt;store/simStore.ts&lt;/b&gt;（zustand・低頻度のみ）&lt;br&gt;init → handshaked / presets / config / params / status&lt;br&gt;map → map（3D の構築をやり直す契機）&lt;br&gt;metrics → &lt;b&gt;metricsSeries にその場で追記&lt;/b&gt;し、&lt;br&gt;　　metricsRevision を 1 つ進める（毎秒 slice() しない）&lt;br&gt;network → network　detector → detector&lt;br&gt;&lt;b&gt;taxi → taxi&lt;/b&gt;（経路は版が変わった通にだけ入る）&lt;br&gt;error → errors（末尾 5 件）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="820" y="462" width="340" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p6-r4" value="&lt;b&gt;3D 配色は zustand の theme を見る&lt;/b&gt;&lt;br&gt;usePalette() → palette.ts の DARK_SCENE / LIGHT_SCENE&lt;br&gt;&lt;b&gt;信号の灯火と標識の板の色だけは昼夜で変えない&lt;/b&gt;&lt;br&gt;&lt;b&gt;「変わったときだけ書く」箇所は、配色が変わったら記録を捨てる&lt;/b&gt;&lt;br&gt;（Vehicles の lastState、TrafficSignals の lastVersion を -1 に戻す）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="820" y="630" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p6-r5" value="&lt;b&gt;パネルの一覧が frameBuffer を読むときの約束&lt;/b&gt;&lt;br&gt;・panelOpen が false の間はポーリングごと止める&lt;br&gt;　（3D を全画面で見たいときにこそ、隠れた行の再描画が乗る）&lt;br&gt;・中身が変わっていなければ setState しない&lt;br&gt;　（毎回新しい配列を返すと Object.is が必ず外れる）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="820" y="758" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p6-r6" value="&lt;b&gt;mockServer.ts（?mock=1・DEV ビルドのみ）&lt;/b&gt;&lt;br&gt;frame / metrics / network と、認識器の学習の疑似ジョブ、&lt;br&gt;実用モードの配車（迎車 → 乗車 → 到着 → 降車）まで返す。&lt;br&gt;歩行者・灯火・方向指示器・player_pose の TTL も再現する。&lt;br&gt;&lt;b&gt;モックだけが契約と違う振る舞いをしないこと&lt;/b&gt;&lt;br&gt;（違う挙動をモックで確かめてしまう）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="820" y="886" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p6-lp" value="描画（60fps）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F2FA;strokeColor=#6750A4;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#21005D;" vertex="1" parent="1">
                    <mxGeometry x="1200" y="100" width="414" height="1040" as="geometry"/>
                </mxCell>
                <mxCell id="p6-p1" value="&lt;b&gt;useFrame（@react-three/fiber・rAF 駆動 60fps）&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1218" y="146" width="380" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p6-p2" value="&lt;b&gt;scene/interpolation.ts&lt;/b&gt;（純粋関数）&lt;br&gt;computeAlpha(now, renderPaused)：20Hz の 2 枚から [0, 1] を作る&lt;br&gt;sampleVehicle()／&lt;b&gt;samplePedestrian()&lt;/b&gt;&lt;br&gt;&lt;b&gt;大きく跳んだら補間しない&lt;/b&gt;（respawn と、誰にも見えていない歩行者の回し直し）&lt;br&gt;歩数の位相は角度と同じ扱いにする（2π で折り返すため）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1218" y="196" width="380" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p6-p3" value="&lt;b&gt;scene/Vehicles.tsx&lt;/b&gt;（InstancedMesh をまとめて 11 ドローコール）&lt;br&gt;車体・ノーズ・窓ガラス・&lt;b&gt;内装&lt;/b&gt;（ダッシュボード・シート・ハンドル・ペダル）&lt;br&gt;&lt;b&gt;メーター&lt;/b&gt;（速度計とパワーメーター。文字盤は 1 枚のアトラス）&lt;br&gt;&lt;b&gt;灯火 8 灯&lt;/b&gt;（前照灯・尾灯・制動灯・方向指示器）&lt;br&gt;&lt;b&gt;ナンバープレート&lt;/b&gt;（8 台ぶんを縦に並べた 1 枚のテクスチャ＋ UV ずらし）&lt;br&gt;&lt;i&gt;1 台 1,888 三角形 / 8 台で 15,104。台数によらずドローコールは一定&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1218" y="314" width="380" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="p6-p4" value="&lt;b&gt;可動部はサーバーの指令だけで決める&lt;/b&gt;&lt;br&gt;ハンドル ← steer × 17.0　／　ペダル ← throttle&lt;br&gt;速度計 ← speedRatio（目盛りは 0〜160km/h 固定）&lt;br&gt;パワーメーター ← powerRatio（中央が 0）&lt;br&gt;制動灯・方向指示器 ← braking / turnSignal（&lt;b&gt;サーバー&lt;/b&gt;が決める）&lt;br&gt;前照灯・ハザード ← 昼夜と配車の段階（&lt;b&gt;クライアント&lt;/b&gt;しか知らない）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1218" y="446" width="380" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="p6-p5" value="&lt;b&gt;scene/CameraRig.tsx&lt;/b&gt;　俯瞰 / 追従 / 運転席 / 徒歩&lt;br&gt;&lt;b&gt;運転席カメラは車体に固定する（追従率 0）&lt;/b&gt;。減衰追従で追わせると、&lt;br&gt;一定速度でも「速度 / rate」だけ後ろに居座り、&lt;b&gt;加減速のたびに車内が前後に滑る&lt;/b&gt;&lt;br&gt;（実測：rate 22・最高速 13.9m/s で 0.63m。目からダッシュボードまでは 0.51m）&lt;br&gt;車外から追いかけるカメラは遅れてよいので 4.5 のまま" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1218" y="578" width="380" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p6-p6" value="&lt;b&gt;scene/NpcPedestrians.tsx&lt;/b&gt;　頭・胴・腰・腕 2・脚 2 を InstancedMesh で（→ ページ 8）&lt;br&gt;&lt;b&gt;scene/PedestrianSignals.tsx&lt;/b&gt;　現示が変わったときだけ灯火色を書く&lt;br&gt;&lt;b&gt;scene/RouteLines.tsx&lt;/b&gt;　routeRevisions を比較して、変わったスロットだけ引き直す&lt;br&gt;&lt;b&gt;scene/Obstacles.tsx&lt;/b&gt;　obstacleVersion 変化時だけ行列を書く" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1218" y="696" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p6-p7" value="&lt;b&gt;描き直す頻度を落としているもの&lt;/b&gt;&lt;br&gt;TaxiCameraFeed　15fps（GPU → CPU の同期転送）&lt;br&gt;NavScreen　　　 12fps（道路と建物をなぞり直す）&lt;br&gt;TaxiMap の静的レイヤ　倍率が 0.16（対数）か画面幅の 22% ずれたときと、&lt;br&gt;　　動きが止まったときだけ引き直す（金沢の 58,120 本で 1 フレームを使い切るため）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1218" y="800" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p6-p8" value="&lt;b&gt;明るさが変わったときだけ GPU へ送る&lt;/b&gt;&lt;br&gt;1.5Hz の点滅（保安基準の毎分 90 回）を毎フレーム送ると、&lt;br&gt;8 台 × 8 灯 × 3 float を 60fps で書き続けることになる。&lt;br&gt;点滅の位相はクライアントが performance.now() から作る&lt;br&gt;（20Hz で送るとカクつく）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1218" y="914" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p6-t1" value="&lt;b&gt;路面に重ねるものは polygonOffset で手前へ押す。高さを離して解決しない&lt;/b&gt;&lt;br&gt;&lt;br&gt;　路面 -1/-2　＜　中央線 -2/-4　＜　白線 -3/-6　＜　進路リボン -4/-8　＜　矢羽根 -5/-10　＜　認識した車線 -6/-12&lt;br&gt;&lt;br&gt;崩すと Z ファイティングで点滅する。&lt;b&gt;車両の内装でも同じことが起きた&lt;/b&gt;——部品どうしの面をぴったり合わせると、&lt;br&gt;どちらが手前か決まらずフレームごとに色が入れ替わる。内装のドアと車体の外板など 17 か所で実際に起き、&lt;br&gt;OVERLAP ぶん食い込ませて直した（npm run verify:vehicles が共有平面の数を検査している）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1170" width="780" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p6-t2" value="&lt;b&gt;npm run verify — ブラウザ無しで 3D の幾何を数値検証する（frontend/scripts/）&lt;/b&gt;&lt;br&gt;&lt;br&gt;向きは間違っていても型チェックもビルドも通ってしまうため、幾何計算を React から切り離した純粋モジュールへ置き、&lt;br&gt;数値で不変条件を検査している（実際に灯火の並びが左右逆になっていたバグをこれが検出した）。&lt;br&gt;&lt;b&gt;本数の出典は frontend/package.json の scripts&lt;/b&gt;（★ ここに本数を書かない。過去に 3 文書で三つ巴のずれを起こした）。&lt;br&gt;Node 22.18 以降が要るのは node scripts/verify-*.ts で TypeScript を直接実行するため" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
                    <mxGeometry x="840" y="1170" width="774" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p6-t3" value="&lt;b&gt;転送量の実測&lt;/b&gt;（銀座・8 台・64 人・真値で走行）：5,871 B/frame ＝ 114.7 KB/s。&lt;b&gt;歩行者を足しても転送は問題にならない&lt;/b&gt;——効くのは描画と推論のほう。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1380" width="1574" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p6-z1" value="frame だけ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A88400;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6-n1" target="p6-r1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-z2" value="frame 以外の 10 種" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6-n1" target="p6-n2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-z3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6-n2" target="p6-r2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-z4" value="毎フレーム直読み" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A88400;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6-r3" target="p6-p3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-z5" value="theme" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D5260;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6-r4" target="p6-p5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-z6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p6-m3" target="p6-n1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-intervene" name="7. ユーザー介入とモデル入出力">
        <mxGraphModel dx="1654" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p7-title" value="7. ユーザー介入（クライアント → サーバー）とモデルの書き出し・読み込み" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1D1B20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="20" width="1300" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p7-sub" value="介入が起きても学習は一時停止しない。「一時停止」は&lt;b&gt;描画のみ&lt;/b&gt;を止め、裏側の学習は動き続ける（止まるものの区別はページ 4 を参照）。送信はすべて store/connection.ts の send() を経由する。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" vertex="1" parent="1">
                    <mxGeometry x="40" y="58" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p7-l1" value="UI 操作 → 送信メッセージ（全 22 種）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F2FA;strokeColor=#6750A4;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#21005D;" vertex="1" parent="1">
                    <mxGeometry x="40" y="100" width="520" height="960" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u1" value="&lt;b&gt;scene/InteractionPlane.tsx&lt;/b&gt;　3D クリック介入&lt;br&gt;不可視の地面平面へレイキャスト。pointerdown 〜 pointerup の&lt;b&gt;移動量 5px 未満&lt;/b&gt;のときだけ「クリック」と見なす（カメラを回しただけで置かない）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="146" width="480" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u2" value="interaction === &#39;obstacle&#39; → &lt;b&gt;add_obstacle&lt;/b&gt; { x, y, radius }　／　&#39;vehicle&#39; → &lt;b&gt;spawn_vehicle&lt;/b&gt; { x, y }（最寄り道路へスナップ）&lt;br&gt;&lt;b&gt;scene/Obstacles.tsx&lt;/b&gt; パイロンをクリック → &lt;b&gt;remove_obstacle&lt;/b&gt; { id }　／　「すべて消す」→ &lt;b&gt;clear_obstacles&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="234" width="480" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u3" value="&lt;b&gt;panel/SimulationTab.tsx&lt;/b&gt;&lt;br&gt;車両数 / &lt;b&gt;歩行者の人数&lt;/b&gt; / シミュレーション速度 / 最高速度のスライダー（&lt;b&gt;onCommit&lt;/b&gt; で確定時のみ送信）&lt;br&gt;「信号に従う」「速度標識に従う」スイッチ、天候（雨・霧・自動）→ すべて &lt;b&gt;set_params&lt;/b&gt;&lt;br&gt;「一時停止」→ &lt;b&gt;set_render_paused&lt;/b&gt;　「エピソードをやり直す」→ &lt;b&gt;reset_episode&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="310" width="480" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u4" value="&lt;b&gt;panel/LearningTab.tsx&lt;/b&gt;&lt;br&gt;学習ハイパーパラメータ（learningRate / gamma / clipRange / entropyCoef）と報酬の重み → &lt;b&gt;set_params&lt;/b&gt;&lt;br&gt;「保存」「読込」「初期化」→ &lt;b&gt;save_checkpoint&lt;/b&gt; / &lt;b&gt;load_checkpoint&lt;/b&gt; / &lt;b&gt;reset_policy&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="414" width="480" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u5" value="&lt;b&gt;panel/NetworkGraph.tsx&lt;/b&gt;（Architecture）&lt;br&gt;層数・幅を選び確認 → &lt;b&gt;set_network&lt;/b&gt; { hiddenSizes[] }　&lt;i&gt;※ PPOTrainer を作り直すので、重みは初期化される&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="502" width="480" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u6" value="&lt;b&gt;panel/ModelTab.tsx&lt;/b&gt;（モデル作成 ＝ 認識器の学習）&lt;br&gt;枚数・エポック・幅・バッチ・天候・弱点を狙う強さを選ぶ → &lt;b&gt;start_detector_training&lt;/b&gt;&lt;br&gt;途中で止める → &lt;b&gt;cancel_detector_training&lt;/b&gt;&lt;br&gt;&lt;i&gt;タブはアンマウントして入れ替わるので、実行中の状態はサーバーから届いた detector.request を初期値にする&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="570" width="480" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u7" value="&lt;b&gt;開発 ↔ 実用のトグル&lt;/b&gt;（操作パネル右上）→ &lt;b&gt;set_app_mode&lt;/b&gt; { practical }&lt;br&gt;&lt;b&gt;panel/TaxiScreen.tsx&lt;/b&gt;（実用モードのスマホ画面）&lt;br&gt;地図で行き先を選び「呼ぶ」→ &lt;b&gt;request_taxi&lt;/b&gt; { pickup, dropoff }&lt;br&gt;　&lt;b&gt;pickup は利用者の現在地&lt;/b&gt;。選ばせない（実際の配車アプリと同じ）&lt;br&gt;[Enter] → &lt;b&gt;board_taxi&lt;/b&gt; / &lt;b&gt;alight_taxi&lt;/b&gt;　[Space] → &lt;b&gt;cancel_taxi&lt;/b&gt; { halt }" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="668" width="480" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u8" value="&lt;b&gt;scene/Pedestrian.tsx&lt;/b&gt;　徒歩キャラの位置を &lt;b&gt;10Hz&lt;/b&gt; で送る → &lt;b&gt;player_pose&lt;/b&gt; { at }&lt;br&gt;&lt;b&gt;これ 1 本で 5 つが同時に利用者を見る&lt;/b&gt;：車間・擬似カメラ・正解ラベル・観測・衝突判定&lt;br&gt;&lt;b&gt;乗車中（riding / arrived）は送らない&lt;/b&gt;——サーバーが乗客を歩行者として扱い、&lt;br&gt;　自分を乗せた車が自分の前で止まって動けなくなる&lt;br&gt;&lt;b&gt;実用モードを抜けるときは at: null を 1 通送る&lt;/b&gt;（TTL 任せだと 1 秒ぶん PPO の環境が変わる）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="784" width="480" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u9" value="&lt;b&gt;panel/MapTab.tsx&lt;/b&gt; プリセット選択 → &lt;b&gt;load_map&lt;/b&gt;（ページ 3 を参照）&lt;br&gt;&lt;b&gt;despawn_vehicle&lt;/b&gt; と &lt;b&gt;ping&lt;/b&gt; は型があり mockServer も受信処理を持つが、実フロントの UI からは一度も送っていない" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="900" width="480" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="p7-u10" value="&lt;b&gt;送信はすべて store/connection.ts の send() を経由する&lt;/b&gt;（ui/ の部品は send も fetch も直接呼ばない）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="60" y="976" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p7-l2" value="asyncio 側の受け付けと検証" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EDF3FE;strokeColor=#0B57D0;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#041E49;" vertex="1" parent="1">
                    <mxGeometry x="600" y="100" width="470" height="960" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v1" value="&lt;b&gt;handle_client_message()&lt;/b&gt; が type で振り分ける&lt;br&gt;不正 JSON・非オブジェクト・未知の type は &lt;b&gt;INVALID_MESSAGE&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="146" width="430" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v2" value="&lt;b&gt;_EVENT_KINDS&lt;/b&gt;（6 種）&lt;br&gt;spawn_vehicle / despawn_vehicle / add_obstacle /&lt;br&gt;remove_obstacle / clear_obstacles / reset_episode&lt;br&gt;→ engine.submit_event(InterventionEvent)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="214" width="430" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v3" value="&lt;b&gt;set_params&lt;/b&gt; → engine.update_params(patch)&lt;br&gt;→ SimParams.apply_wire() が &lt;b&gt;contracts._PARAM_SPECS&lt;/b&gt; の値域で検証・クリップし、弾いた項目を status.message で返す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="300" width="430" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v4" value="&lt;b&gt;値域検証は必須&lt;/b&gt;&lt;br&gt;{ gamma: nan } のような非有限値が通ると GAE 全体が NaN になり、optimizer.step() で重みが全滅する。&lt;br&gt;しかも env は動き続けるので、画面上は「走っているのに何も学ばない」状態になり、原因にたどり着けない" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="378" width="430" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v5" value="&lt;b&gt;set_network&lt;/b&gt; → contracts.validate_hidden_sizes()&lt;br&gt;1〜4 層・幅 16〜512 を検証してから engine.set_hidden_sizes()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="492" width="430" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v6" value="&lt;b&gt;_COMMAND_KINDS&lt;/b&gt;（3 種）save_checkpoint / load_checkpoint / reset_policy → engine.command(kind)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="560" width="430" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v7" value="&lt;b&gt;start_detector_training&lt;/b&gt; → 値域を検証して detector_job を起動（&lt;b&gt;マップ未読込なら断る&lt;/b&gt;）&lt;br&gt;&lt;b&gt;cancel_detector_training&lt;/b&gt; → ジョブへ取り消しを立てる" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="622" width="430" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v8" value="&lt;b&gt;set_app_mode&lt;/b&gt; → engine.set_app_mode(practical)&lt;br&gt;&lt;b&gt;request_taxi / board_taxi / alight_taxi / cancel_taxi&lt;/b&gt; → engine.submit_taxi(action, payload)&lt;br&gt;&lt;b&gt;player_pose&lt;/b&gt; → engine.submit_player_pose(at)　&lt;i&gt;10Hz で来るので検証は軽く（有限値かだけ）&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="694" width="430" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v9" value="&lt;b&gt;set_render_paused&lt;/b&gt; → engine.set_render_paused() → status を broadcast&lt;br&gt;&lt;b&gt;ping&lt;/b&gt; → その場で pong を返信" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="784" width="430" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p7-v10" value="&lt;b&gt;error は 5 コードだけ&lt;/b&gt;：MAP_LOAD_FAILED / INVALID_MESSAGE / NO_MAP_LOADED / SPAWN_FAILED / INTERNAL&lt;br&gt;&lt;b&gt;断った理由は error ではなく status.message で返す&lt;/b&gt;（配車を断る、値をクリップした、など）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="620" y="852" width="430" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="p7-l3" value="エンジンスレッド（ステップ境界で反映）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#072711;" vertex="1" parent="1">
                    <mxGeometry x="1110" y="100" width="504" height="960" as="geometry"/>
                </mxCell>
                <mxCell id="p7-w1" value="&lt;b&gt;_drain_inbox()&lt;/b&gt; がステップ境界で取り出す（物理・学習の途中に割り込まない）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="146" width="464" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p7-w2" value="&lt;b&gt;env.apply_event(InterventionEvent)&lt;/b&gt;&lt;br&gt;車両スポーンは最寄りの走行可能道路へスナップし、world._start_is_clear() で既存車との間隔を確かめてから置く" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="208" width="464" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="p7-w3" value="&lt;b&gt;env.apply_params()&lt;/b&gt;&lt;br&gt;台数判定は &lt;b&gt;world.active_count&lt;/b&gt; と比べる。self.params.vehicle_count と比べると、3D 画面のクリックで増えた台数がスライダー値と食い違ったまま固定される。&lt;br&gt;&lt;b&gt;歩行者の人数も同じ経路&lt;/b&gt;（crowd.count と比べて set_pedestrian_count）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="286" width="464" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="p7-w4" value="&lt;b&gt;set_hidden_sizes&lt;/b&gt; → PPOTrainer を作り直す&lt;br&gt;（パラメータの微調整ではなく「作り直し」なので、set_params ではなく専用メッセージにしてある）&lt;br&gt;&lt;b&gt;save / load / reset もステップ境界で実行&lt;/b&gt;。asyncio 側から直接 state_dict() を取ると、optimizer.step() の途中の中途半端な重みを掴む" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="392" width="464" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p7-w5" value="&lt;b&gt;_apply_app_mode(practical)&lt;/b&gt;&lt;br&gt;・env.autopilot_all = practical（実用モードの間は&lt;b&gt;全車が経路追従&lt;/b&gt;）&lt;br&gt;・&lt;b&gt;モードを切り替えたら配車は必ず畳む&lt;/b&gt;。畳まないと、徴用したままの車両が&lt;br&gt;　開発モードの学習対象に戻り、経路も停車指示も残る&lt;br&gt;・&lt;b&gt;徒歩キャラも消す&lt;/b&gt;（開発モードに徒歩キャラは居ない）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="510" width="464" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="p7-w6" value="&lt;b&gt;_apply_player_pose(at)&lt;/b&gt;&lt;br&gt;&lt;b&gt;乗車中と開発モードでは必ず消す&lt;/b&gt;（判断は&lt;b&gt;両側&lt;/b&gt;に置く。クライアントも送らない）&lt;br&gt;届かなくなったら 1 秒（PLAYER_POSE_TTL_SEC）で街から消す&lt;br&gt;&lt;b&gt;街に立つのは 1 人だけ&lt;/b&gt;。複数タブでは最後に届いた位置が勝つ&lt;br&gt;&lt;b&gt;frame へ返さない&lt;/b&gt;（クライアントは自分のキャラを自分で描いている）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="620" width="464" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="p7-w7" value="&lt;b&gt;マップ切替時は trainer.reset_rollout()&lt;/b&gt;&lt;br&gt;収集中のロールアウトを引き継ぐと GAE が新旧マップをまたいでしまう&lt;br&gt;&lt;b&gt;エピソード統計も落とす&lt;/b&gt;（env._reset_slot_stats）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="730" width="464" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p7-w8" value="&lt;b&gt;認識器の学習は engine ではなく detector-train スレッドで走る&lt;/b&gt;&lt;br&gt;開始時に suspend_sim()、終了時に resume_sim() を&lt;b&gt;inbox 経由&lt;/b&gt;で積む。&lt;br&gt;&lt;b&gt;reload_detector より先に再開すると、古い認識器のまま 1 ステップ進む&lt;/b&gt;&lt;br&gt;（止めるのは即座、再開は順序つき）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="820" width="464" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p7-h" value="モデルの書き出し・読み込み（HTTP。WebSocket の save_checkpoint / load_checkpoint とは別経路）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F1F4;strokeColor=#79747E;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#1D1B20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1090" width="1574" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="p7-h1" value="&lt;b&gt;GET /api/export/{kind}&lt;/b&gt;　kind ∈ checkpoint / torchscript / keras&lt;br&gt;LearningTab の「重み一式（.pt）」「TorchScript」「Keras」ボタン → store/exportModel.ts の downloadModel()&lt;br&gt;&lt;br&gt;エンジンスレッドがステップ境界で書き出す（ExportTicket を _inbox へ積み、完了を待つ）。&lt;br&gt;&lt;b&gt;観測レイアウトと行動スケールをメタデータとして必ず埋める&lt;/b&gt;——無いと、受け取った側は&lt;br&gt;66 次元の入力に何を入れればよいか分からない。&lt;br&gt;&lt;b&gt;.keras 書き出しは value ヘッドの shape に注意&lt;/b&gt;（過去に取りこぼしている）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1130" width="760" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p7-h2" value="&lt;b&gt;POST /api/import&lt;/b&gt;　multipart/form-data（&lt;b&gt;checkpoint 形式の .pt のみ&lt;/b&gt;）&lt;br&gt;LearningTab の非表示 input[type=file] → importModel()&lt;br&gt;&lt;br&gt;1MB ずつ data/uploads/ へ書き（上限 256MB、超過は 413）、エンジンスレッドが&lt;br&gt;&lt;b&gt;weights_only=True&lt;/b&gt; で検証してから載せ替える。&lt;b&gt;フォールバックしない&lt;/b&gt;（SECURITY.md）。&lt;br&gt;観測次元・行動次元・層構成が合わなければ断る。&lt;br&gt;&lt;b&gt;タイムアウトしても finally でアップロードを消さない&lt;/b&gt;——エンジンがまだ読んでいる最中に&lt;br&gt;消すと競合する。読み終えた側が消す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="840" y="1130" width="754" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p7-q1" value="WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-u3" target="p7-v1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7-q2" value="_inbox 経由" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-v1" target="p7-w1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7-q3" value="ステップ境界で実行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-w1" target="p7-w2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p7-q4" value="HTTP（WebSocket とは別経路）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#79747E;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p7-u4" target="p7-h1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="300" y="1070"/>
                            <mxPoint x="440" y="1070"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-pedestrian" name="8. 街を歩く歩行者と歩行者用信号">
        <mxGraphModel dx="1492" dy="851" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1420" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p8-title" value="8. 街を歩く歩行者と歩行者用信号" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1D1B20;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1000" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p8-sub" value="最大 64 人（config.MAX_PEDESTRIANS）を numpy でまとめて進める。人数は params.pedestrianCount で、&lt;b&gt;擬似カメラ・正解ラベル・観測・衝突判定のすべてに効く&lt;/b&gt;。歩行者用信号は&lt;b&gt;車両信号の裏返し&lt;/b&gt;で、地図データにも frame にも項目を足していない。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1800" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p8-la" value="サーバー側（sim/pedestrians.py）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#072711;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="660" height="1020" as="geometry"/>
                </mxCell>
                <mxCell id="p8-net" value="&lt;b&gt;SidewalkNetwork&lt;/b&gt;　道路網を歩かせるために前処理したもの（マップ読込時に 1 回）&lt;br&gt;・短すぎるエッジ（8m 未満）を外す&lt;br&gt;・全エッジのポリラインを 1 本の配列へ連結し、累積弧長を持つ&lt;br&gt;・ノードごとに「そこから出ていけるエッジ」を CSR 形式で持つ（隣接表）&lt;br&gt;・歩道の左右オフセット ＝ 道路の半幅 ＋ PEDESTRIAN_SIDEWALK_MARGIN（1.7m）&lt;br&gt;・&lt;b&gt;エッジの端ごとに「そこへ入る車両を規制する信号」を引けるようにする&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;実測：銀座 5.6ms / 金沢 &lt;b&gt;635.4ms&lt;/b&gt;（57,128 本）。エンジンスレッドで走る（code_review V-06）&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="146" width="620" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p8-state" value="&lt;b&gt;★ 状態は「どのエッジの歩道を、どちら向きに、左右どちら側を歩いているか」で持つ&lt;/b&gt;&lt;br&gt;edge / dir（±1）/ side（±1）/ arc（弧長）/ speed / cross（横断の進捗 0→1）/ crossing / waiting&lt;br&gt;&lt;br&gt;&lt;b&gt;座標を直接積分すると建物へめり込み、道路から離れていく。&lt;/b&gt;&lt;br&gt;位置は毎ステップ _refresh_pose() がエッジ上の状態から作り直す&lt;br&gt;（&lt;b&gt;外から x / y を書いても次のステップで消える&lt;/b&gt;）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="312" width="620" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p8-step" value="&lt;b&gt;crowd.step(dt, phases)&lt;/b&gt;　毎ステップ（world.advance_time の中）&lt;br&gt;① 信号待ちの人を、渡ってよくなったら渡らせる（_release_waiting）&lt;br&gt;② 歩いている人の arc を進める（速度は 1.35 ± 0.35 m/s）&lt;br&gt;③ 横断中の人の cross を進める（車道の&lt;b&gt;中央まで出る&lt;/b&gt;。専用の経路は持たない）&lt;br&gt;④ エッジの端に着いた人を、横断させるか次のエッジへ移す（_handle_ends）&lt;br&gt;⑤ _refresh_pose() で x / y / heading を作り直す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="448" width="620" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p8-recycle" value="&lt;b&gt;★ どの車からも 220m 以上離れた歩行者は、車の近くへ回す&lt;/b&gt;（recycle。2 秒ごと）&lt;br&gt;無いと広いマップで 1 人も画に写らない——金沢 12.3km 四方に 64 人 ＝ &lt;b&gt;0.42 人/km²&lt;/b&gt;で、&lt;br&gt;実測の真値は 0 件だった（回すようにして 5 件）。&lt;br&gt;&lt;b&gt;誰にも見えていない人しか動かさないので、画面上でワープして見えることはない。&lt;/b&gt;&lt;br&gt;&lt;i&gt;フロントは車両と同じく、大きく跳んだら補間しない（samplePedestrian）&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="584" width="620" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p8-xy" value="&lt;b&gt;★ これらが見る一覧は world.pedestrian_xy で、crowd そのものではない&lt;/b&gt;&lt;br&gt;&lt;br&gt;　NPC 群衆（crowd.positions）　＋　&lt;b&gt;実用モードの徒歩キャラ（World.set_player）&lt;/b&gt;&lt;br&gt;&lt;br&gt;ここが唯一の出典なので、混ぜるだけで&lt;b&gt;擬似カメラ・正解ラベル・観測・車間・衝突判定の 5 つ&lt;/b&gt;が&lt;br&gt;同時に利用者を見るようになる。&lt;b&gt;新しく歩行者を見たい処理を足すときも必ずこのプロパティを通すこと&lt;/b&gt;&lt;br&gt;（crowd.positions を直接読むと、利用者だけが見えない処理が静かに増える）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="710" width="620" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p8-gather" value="&lt;b&gt;教師データを集めるときだけ使う 2 つ&lt;/b&gt;&lt;br&gt;relocate()　全員を街中へ置き直す（エピソードのリセット）&lt;br&gt;gather_near()　車両の周りへ寄せ集める。&lt;b&gt;道路網の上で位置を決めるので、寄せても歩道から外れない&lt;/b&gt;&lt;br&gt;&lt;i&gt;既定の寄せ半径は 115m。狙うときだけ 26m（狭めすぎると歩行者が他クラスを押しのける）&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="856" width="620" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p8-arc" value="&lt;b&gt;★ MapIndex.nearest_road_point() の 4 番目の戻り値は接線方位であって弧長ではない&lt;/b&gt;&lt;br&gt;そのまま弧長として使うと、置いたつもりの場所とまったく違う所に立つ&lt;br&gt;（実測で「車の 30m 前方」に置いたつもりが 6.5m 後方に出た）。弧長は SidewalkNetwork.arc_of() が出す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="962" width="620" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p8-lb" value="信号との関係（車両信号の裏返し）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EDF3FE;strokeColor=#0B57D0;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#041E49;" parent="1" vertex="1">
                    <mxGeometry x="730" y="100" width="640" height="1020" as="geometry"/>
                </mxCell>
                <mxCell id="p8-sig1" value="&lt;b&gt;歩行者用の信号は「車両信号の裏返し」で作る&lt;/b&gt;&lt;br&gt;&lt;br&gt;　横断するエッジを走る車が&lt;b&gt;赤で止まっていれば渡ってよい&lt;/b&gt;、という 1 対 1 の対応。&lt;br&gt;&lt;br&gt;地図データにも frame にも項目を足していない。&lt;br&gt;_build_signal_table() がエッジの端ごとに車両信号を引けるようにしてあり、&lt;br&gt;&lt;b&gt;灯器の位置も map.signals から導ける&lt;/b&gt;（scene/pedestrianSignalGeometry.ts）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="146" width="600" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p8-sig2" value="&lt;b&gt;★ 信号を見るのは渡り「始める」ときだけ&lt;/b&gt;&lt;br&gt;渡っている最中に赤へ変わっても引き返させない（実際の歩行者と同じく渡り切る）。&lt;br&gt;引き返させると、車道のまん中で向きを変える不自然な動きになる&lt;br&gt;&lt;br&gt;&lt;b&gt;★ 現示を作り直した後に crowd.step() へ渡すこと&lt;/b&gt;（world.advance_time）&lt;br&gt;1 ステップ古い色で渡らせると、青になる直前に飛び出す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="292" width="600" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p8-sig3" value="&lt;b&gt;信号の無い交差点では従来どおり自由に渡る&lt;/b&gt;&lt;br&gt;銀座では歩道の端 542 か所のうち &lt;b&gt;271 か所（50%）&lt;/b&gt;にしか信号が結び付かない&lt;br&gt;（元の OSM データに交差点あたり数基しか無いため）。&lt;br&gt;&lt;br&gt;&lt;b&gt;実測&lt;/b&gt;（銀座・64 人・120 秒）：赤のうちに渡り始めた回数は 56 回中 &lt;b&gt;0 回&lt;/b&gt;、&lt;br&gt;いちばん長い信号待ちは 27.8 秒（サイクルは 60 秒）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="428" width="600" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p8-sig4" value="&lt;b&gt;⚠ 未対応：歩行者が見る灯器と、車が見る灯器が別物になりうる&lt;/b&gt;（code_review V-02）&lt;br&gt;&lt;br&gt;車側は signals_on_route() が&lt;b&gt;経路上で 8m 以内に並んだ灯器を 1 基へまとめる&lt;/b&gt;&lt;br&gt;（SIGNAL_MERGE_M。片方が青でも片方が赤になって車が動けなくなる対策）。&lt;br&gt;&lt;b&gt;歩行者側はまとめない&lt;/b&gt;——「向きがいちばん近い灯器」を選ぶだけなので、&lt;br&gt;車がまとめて捨てた方を見ることがある。現示は node_id からオフセットを決めるので&lt;br&gt;別ノードの 2 基は位相がずれ、片方が赤のときもう片方は青でありうる。&lt;br&gt;&lt;br&gt;&lt;b&gt;実測&lt;/b&gt;　銀座：位相の違う灯器が 8m 以内にあるもの 31 基。それを見ている歩道の端 35 か所（12.9%）&lt;br&gt;　　　　金沢：211 基 / 320 か所（6.5%）&lt;br&gt;　　　　銀座・64 人・120 秒で、横断開始 22 回のうち &lt;b&gt;3 回（13.6%）&lt;/b&gt;が食い違っていた&lt;br&gt;&lt;br&gt;&lt;b&gt;直し方&lt;/b&gt;：マージ規則を map/index.py 側の公開関数として出し、歩行者側もそれを通す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="564" width="600" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p8-sig5" value="&lt;b&gt;3D の灯器（scene/PedestrianSignals.tsx）&lt;/b&gt;&lt;br&gt;車両信号 1 基につき、その停止線の先にある&lt;b&gt;横断歩道の両端&lt;/b&gt;へ 1 基ずつ立てる。&lt;br&gt;渡ってくる人に正対させるので、左端の灯器は右を、右端の灯器は左を向く。&lt;br&gt;縦 2 灯（上が赤・下が青。&lt;b&gt;車両用とは並びが違う&lt;/b&gt;）。灯火径 250mm、取り付け高 2.55m&lt;br&gt;&lt;br&gt;&lt;b&gt;⚠ 未対応：車両用の 1.5 倍の負荷&lt;/b&gt;（code_review V-05）&lt;br&gt;　金沢で灯器 5,472 基 / 灯火 10,944 個 / 三角形 218,880 / 構築 187ms&lt;br&gt;　（車両用は 415,872 三角形 / 258ms）。useMemo の中なのでレンダー中に走る。&lt;br&gt;　&lt;b&gt;半分は「車が見ない灯器」の分身&lt;/b&gt;なので、V-02 と同時に直せる" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="800" width="600" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p8-lc" value="フロントエンド（描画と徒歩キャラ）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F2FA;strokeColor=#6750A4;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#21005D;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="100" width="660" height="1020" as="geometry"/>
                </mxCell>
                <mxCell id="p8-npc" value="&lt;b&gt;scene/NpcPedestrians.tsx&lt;/b&gt;&lt;br&gt;頭・胴・腰・腕 2 本・脚 2 本を InstancedMesh で描く（最大 64 人ぶんを確保）。&lt;br&gt;服の色は palette の色から色相と明度だけ散らす（instanceColor）。&lt;br&gt;手足の振りは frame.pedestrians[].stride の位相から作る&lt;br&gt;（&lt;b&gt;サーバーが送るのは描画のためだけの値&lt;/b&gt;）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="146" width="620" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p8-player" value="&lt;b&gt;scene/Pedestrian.tsx&lt;/b&gt;　実用モードの徒歩キャラ（利用者が操作する 1 人）&lt;br&gt;WASD ＋ ポインタロックで歩く。&lt;b&gt;位置は 60fps で動くので zustand に入れない&lt;/b&gt;&lt;br&gt;（store/pedestrian.ts のモジュールスコープに置く。frameBuffer と同じ作法）&lt;br&gt;&lt;br&gt;&lt;b&gt;★ ただし位置は 10Hz でサーバーへ送ること&lt;/b&gt;（player_pose。→ ページ 7）&lt;br&gt;送らないと、車は目の前に立っても止まらず、轢いてもすり抜ける。&lt;br&gt;&lt;i&gt;実測（銀座・経路追従）：8.33 m/s から 4.50m 手前で停止、どかすと再発進&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="268" width="620" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p8-coll" value="&lt;b&gt;scene/pedestrianCollision.ts&lt;/b&gt;（React から切り離した純粋モジュール）&lt;br&gt;・建物は&lt;b&gt;格子索引&lt;/b&gt;で引く（毎フレーム数千件を総当たりしないため）&lt;br&gt;・移動は&lt;b&gt;軸ごとに試して、当たった軸だけ捨てる&lt;/b&gt;（壁沿いに滑らせる定石）。&lt;br&gt;　まとめて判定すると、壁に少し触れただけで完全に動けなくなる&lt;br&gt;・車体は向きつきの矩形に半径ぶん膨らませて避ける&lt;br&gt;・照準（乗車判定）は&lt;b&gt;距離 9m・視線から ±0.5rad&lt;/b&gt;。真横に接しているときは角度を問わない&lt;br&gt;&lt;i&gt;npm run verify:pedestrian が寸法・姿勢・当たり判定・補間を数値で検査する&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="414" width="620" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p8-stop" value="&lt;b&gt;実用モードでは歩行者の 4.5m 手前で止まる&lt;/b&gt;（env._pedestrian_gap）&lt;br&gt;&lt;b&gt;_lead_gap と同じく、経路追従の車にだけ掛けること&lt;/b&gt;。学習中の車に掛けると&lt;br&gt;「歩行者を轢かない世界」になり、PPO から見た環境が変わってしまう。&lt;br&gt;PPO 側は観測（歩行者の欄 3×3 と走行可能領域）から自分で止まれるようになる。&lt;br&gt;&lt;br&gt;見る相手は world.pedestrian_xy ＝ &lt;b&gt;NPC 群衆と利用者の徒歩キャラの両方&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="560" width="620" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p8-percep" value="&lt;b&gt;認識の対象としての歩行者&lt;/b&gt;（→ ページ 5）&lt;br&gt;・擬似カメラは「胴の矩形 ＋ 頭の楕円」で描く&lt;br&gt;・正解ラベルは「視線に垂直な板（肩幅 0.52m × 身長 1.68m）」を箱にする&lt;br&gt;・遮蔽は建物（占有グリッド）＋ 他車の車体の&lt;b&gt;両方&lt;/b&gt;を見る&lt;br&gt;・走行可能領域（freespace）の blocker にも入る（半径 0.26m）&lt;br&gt;・検出クラス PEDESTRIAN = 5、CLASS_QUOTA は 3 件" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="696" width="620" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p8-metrics" value="&lt;b&gt;歩行者との衝突は指標に分けて出す&lt;/b&gt;&lt;br&gt;world.pedestrian_hits → EpisodeResult.hit_pedestrian → metrics.pedestrianCollisionRate&lt;br&gt;学習タブでは「衝突率」の隣に「うち歩行者」として並べ、グラフも 1 本足してある" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="832" width="620" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p8-foot" value="&lt;b&gt;実測（銀座 / 金沢・8 台・64 人・真値で走行）&lt;/b&gt;　1 ステップ 9.9ms / 14.0ms（歩行者 0 人なら 6.5ms / 10.4ms ＝ 増分は &lt;b&gt;+3.4ms / +3.6ms&lt;/b&gt;）。転送は 5,871 B/frame ＝ 114.7 KB/s。&lt;br&gt;&lt;b&gt;歩行者を足したぶんは軽い。&lt;/b&gt;重いのは認識器の推論（ページ 5）と、歩行者用信号の 3D（V-05）のほう。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1150" width="2020" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p8-foot2" value="&lt;b&gt;★ 歩行者の人数を変えたときに一緒に効くもの&lt;/b&gt;：擬似カメラの描画（1 人ぶんの矩形 2 個）／ 正解ラベル（遮蔽判定のレイキャストが 1 人ぶん増える）／ 観測の歩行者の欄（近い 3 人）／ 走行可能領域の blocker ／ 衝突判定 ／ 3D の InstancedMesh の count。&lt;br&gt;&lt;b&gt;どれも world.pedestrian_xy 経由なので、人数を変える経路は params の 1 本だけでよい。&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1240" width="2020" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p8-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p8-net" target="p8-state" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p8-state" target="p8-step" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p8-step" target="p8-recycle" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3261E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p8-recycle" target="p8-xy" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p8-e5" value="現示（MapData.signals と同じ並び）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p8-sig1" target="p8-npc" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1385" y="211"/>
                            <mxPoint x="1385" y="199"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p8-e6" value="crowd.step(dt, phases)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p8-sig1" target="p8-step" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="715" y="211"/>
                            <mxPoint x="715" y="508"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p8-e7" value="frame.pedestrians[]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p8-xy" target="p8-npc" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1390" y="775"/>
                            <mxPoint x="1390" y="199"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p8-e8" value="player_pose（10Hz）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D5260;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p8-player" target="p8-xy" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1380" y="333"/>
                            <mxPoint x="1380" y="808"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-taxi" name="9. 実用モード（自動運転タクシー）">
        <mxGraphModel dx="3592" dy="851" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p9-title" value="9. 実用モード（自動運転タクシー）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1D1B20;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1000" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p9-sub" value="操作パネル右上のトグルで&lt;b&gt;開発モード&lt;/b&gt;（学習を回す）と&lt;b&gt;実用モード&lt;/b&gt;（学習済みの重みでタクシーを呼ぶ）を切り替える。runtime/taxi.py が配車 1 件ぶんの状態を持つ（&lt;b&gt;同時 1 件&lt;/b&gt;）。契約は docs/protocol.md 2.10。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1800" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p9-la" value="配車の段階（TaxiStatus.phase）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F1F4;strokeColor=#7D5260;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#31111D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="520" height="1080" as="geometry"/>
                </mxCell>
                <mxCell id="p9-s0" value="&lt;b&gt;idle&lt;/b&gt;　配車していない" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="140" y="146" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p9-s1" value="&lt;b&gt;approaching&lt;/b&gt;　迎車中&lt;br&gt;&lt;i&gt;乗車地点へ向かっている&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="140" y="256" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p9-s2" value="&lt;b&gt;waiting&lt;/b&gt;　乗車地点で待っている&lt;br&gt;&lt;i&gt;ハザードを出して停車&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="140" y="376" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p9-s3" value="&lt;b&gt;riding&lt;/b&gt;　乗車中&lt;br&gt;&lt;i&gt;カメラは運転席へ。徒歩キャラは消える&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="140" y="496" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p9-s4" value="&lt;b&gt;arrived&lt;/b&gt;　目的地に到着&lt;br&gt;&lt;b&gt;★ まだ乗車中&lt;/b&gt;（降車が確定するのは alight_taxi を受けたとき）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=12;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="140" y="616" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p9-pred" value="&lt;b&gt;★ 段階から「いま何ができるか」を導くのは&lt;br&gt;types/protocol.ts の 3 つの述語だけ&lt;/b&gt;&lt;br&gt;&lt;br&gt;isRidingPhase　riding / &lt;b&gt;arrived&lt;/b&gt;（車内にいる）&lt;br&gt;isBoardablePhase　approaching / waiting（乗り込める）&lt;br&gt;isWaitingPhase　waiting / &lt;b&gt;arrived&lt;/b&gt;（ハザードを出す）&lt;br&gt;&lt;br&gt;サーバーの taxi.alight() / taxi.board() が受け付ける段階と&lt;b&gt;一致させること&lt;/b&gt;。&lt;br&gt;以前は TaxiScreen / TaxiHud / Pedestrian が各自で判定していて、&lt;br&gt;&lt;b&gt;Pedestrian だけが arrived を含め忘れ&lt;/b&gt;、到着した瞬間に操作もしていないのに&lt;br&gt;車外へ降ろされたうえ、画面が案内している [Enter] が効かなくなった" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="712" width="480" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p9-plate" value="&lt;b&gt;実用モードの画面は車をナンバープレートで指す&lt;/b&gt;&lt;br&gt;サーバーの文言に含まれる「車両 #N」は withPlateNames() が差し替える。&lt;br&gt;&lt;b&gt;番号を文中に持つのはサーバー側&lt;/b&gt;（どの車からどの車へかを知っている側でしか作れない）で、&lt;br&gt;地名の対応表はクライアントにしかないため、この分担になった。&lt;br&gt;&lt;b&gt;開発モードの一覧・カメラ選択は番号のまま&lt;/b&gt;（そちらは識別が目的）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="910" width="480" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p9-plate2" value="&lt;b&gt;⚠ 未対応&lt;/b&gt;：車載カメラの帯だけが `#5` とスロット番号を出している（code_review V-10）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1046" width="480" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p9-e1" value="request_taxi&lt;br&gt;（徴用 ＋ 経路）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D5260;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p9-s0" target="p9-s1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p9-e2" value="乗車地点に到着（4m 以内・0.8m/s 以下）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D5260;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p9-s1" target="p9-s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p9-e3" value="board_taxi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p9-s2" target="p9-s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p9-e3b" value="&lt;b&gt;乗車は迎車の途中でも受け付ける&lt;/b&gt;（近くで拾えたならそれでよい）&lt;br&gt;経路は必ず&lt;b&gt;いまいる場所から&lt;/b&gt;作り直すので矛盾しない" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p9-s1" target="p9-s3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="90" y="281"/>
                            <mxPoint x="90" y="521"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p9-e4" value="降車地点に到着" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p9-s3" target="p9-s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p9-e5" value="alight_taxi（徴用を解いて PPO の走行へ戻す）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#79747E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p9-s4" target="p9-s0" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="510" y="644"/>
                            <mxPoint x="510" y="166"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p9-lb" value="サーバー側（runtime/taxi.py ＋ sim/env.py）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#072711;" parent="1" vertex="1">
                    <mxGeometry x="600" y="100" width="700" height="1080" as="geometry"/>
                </mxCell>
                <mxCell id="p9-b1" value="&lt;b&gt;★ 実用モードの間は全車が PPO ではなく経路追従で走る&lt;/b&gt;&lt;br&gt;（env.autopilot_all → _autopilot_slots）&lt;br&gt;手元のモデルが停止方策に寄っていても&lt;b&gt;必ず迎えに来させる&lt;/b&gt;ため。&lt;br&gt;&lt;b&gt;徴用車 1 台だけでは足りない&lt;/b&gt;——街の車が止まったままだと道を塞ぎ、&lt;br&gt;タクシーがその後ろで詰まる（実測：全車追従にして 30 秒での移動が 11〜139m、&lt;br&gt;止まったままの台数 0/6）。&lt;br&gt;&lt;b&gt;信号・規制速度・カーブ・乗降地点での停車は constrain_accel がそのまま効く&lt;/b&gt;ので、&lt;br&gt;赤信号は守るし制限速度も超えない。&lt;b&gt;開発モードでは必ず False に戻すこと&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="146" width="660" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p9-b2" value="&lt;b&gt;舵角は目標点を通る円弧の曲率から出す&lt;/b&gt;（Pure Pursuit。δ = atan(L·2sinα/d)）&lt;br&gt;角度差をそのまま舵角にすると急カーブで切り足りず、膨らんで建物へ突っ込む&lt;br&gt;（実測：金沢で横ずれが 0.17m → 6.55m に開いて衝突。曲率式にして 4 回 → 2 回）。&lt;br&gt;&lt;b&gt;経路から離れているほど目標点を手前に詰める&lt;/b&gt;（離れたまま遠くを見ると戻れない）&lt;br&gt;&lt;br&gt;&lt;b&gt;曲がっている間は加速しないが、止まっているときは必ず加速する&lt;/b&gt;&lt;br&gt;切ったまま停まると角度差が変わらないので、「曲がっているから加速しない」だけだと&lt;br&gt;&lt;b&gt;二度と発進できない&lt;/b&gt;（実測：銀座で 361 秒動かなくなった）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="300" width="660" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p9-b3" value="&lt;b&gt;経路追従には前走車との車間が要る&lt;/b&gt;（env._lead_gap）&lt;br&gt;経路しか見ないので、これが無いと&lt;b&gt;止まっている車へ必ず追突する&lt;/b&gt;。&lt;br&gt;車間も赤信号と同じ式で、車長 ＋ 2.5m 手前で止まる。&lt;br&gt;&lt;b&gt;★ 見る相手は「同じ向きに走っている前方 45m 以内の車」だけ&lt;/b&gt;——交差点で直交する車や&lt;br&gt;対向車まで前走車として数えると、&lt;b&gt;互いに相手の前方に居座って双方が永久に止まる&lt;/b&gt;&lt;br&gt;（実測で 444 秒）。交差する流れは信号が捌くので見なくてよい" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="454" width="660" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p9-b4" value="&lt;b&gt;乗降地点は道路ノードへ寄せる&lt;/b&gt;（world.snap_to_road_node）&lt;br&gt;道路中心線上の任意の点にすると、経路はノード間で作られるので「目的地を通り過ぎて&lt;br&gt;次の交差点まで行き、折り返して戻る」形になる（実測：銀座で 64% の経路が平均 8.6m・&lt;br&gt;最大 28.8m 行き過ぎていた。金沢では 72%）。&lt;br&gt;&lt;b&gt;停めるのは赤信号と同じ式&lt;/b&gt;（signals.stop_speed_limit）で、経路の終点を「越えてはいけない線」&lt;br&gt;として速度上限を掛けるだけ。&lt;i&gt;実測の停車精度：乗車 0.05m / 降車 0.12m&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="588" width="660" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p9-b5" value="&lt;b&gt;★ 迎えに行けなくなった車は、配車を畳まずに別の車へ引き継ぐ&lt;/b&gt;（_handover）&lt;br&gt;引き金は 3 つ：&lt;b&gt;事故&lt;/b&gt; / &lt;b&gt;車両の消失&lt;/b&gt; / &lt;b&gt;25 秒間まったく近づけない&lt;/b&gt;（_stalled）&lt;br&gt;　collided_flags は&lt;b&gt;当たった瞬間しか立たない&lt;/b&gt;ので、当たらずに詰まって動けない形は&lt;br&gt;　3 つめでしか拾えない（交差点の睨み合いや塞がれた道で実際に起きる）&lt;br&gt;&lt;br&gt;&lt;b&gt;守ること&lt;/b&gt;&lt;br&gt;・&lt;b&gt;段階は畳まず approaching へ戻す&lt;/b&gt;。一度でも idle を挟むと、フロントは配車が&lt;br&gt;　終わったものとして扱う（歩行者を降ろし、画面を初期化する）&lt;br&gt;・&lt;b&gt;引き継げるのは乗せる前だけ&lt;/b&gt;。riding / arrived は車内に人がいるので従来どおり打ち切る&lt;br&gt;・&lt;b&gt;一度あきらめた車は同じ配車の間は選ばない&lt;/b&gt;（_tried）。手放した車の事故フラグは&lt;br&gt;　release_vehicle() の経路差し替えで&lt;b&gt;消える&lt;/b&gt;ので、除外しないと 2 台の間を往復する&lt;br&gt;　（実測で #1 → #5 → #1 → #5）&lt;br&gt;・&lt;b&gt;上限は 3 回&lt;/b&gt;（MAX_HANDOVERS）。事故が続くと延々と粘ってしまう&lt;br&gt;・&lt;b&gt;vehicle_id も配信の契機にする&lt;/b&gt;。段階が変わらないので、1Hz を待つと最大 1 秒古い車を追う&lt;br&gt;&lt;br&gt;&lt;i&gt;引き継ぎ 1 回のコストは配車と同じ（_assign が route_between を最大 4 回）。&lt;br&gt;実測 銀座 6.0ms / 金沢 17.2ms&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="722" width="660" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="p9-b6" value="&lt;b&gt;徴用中はエピソードを閉じない&lt;/b&gt;（env.step が dones[held] = False）&lt;br&gt;閉じると乗降地点に着いた瞬間に respawn し、乗客を置いて別の街区へ飛ぶ&lt;br&gt;&lt;br&gt;&lt;b&gt;モードを切り替えたら配車は必ず畳む&lt;/b&gt;（_apply_app_mode）&lt;br&gt;畳まないと、徴用したままの車両が開発モードの学習対象に戻り、経路も停車指示も残る" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="988" width="660" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p9-b7" value="&lt;b&gt;配車の経路探索はエンジンスレッドで走る&lt;/b&gt;　実測 銀座 2.0ms / 金沢 18.8ms（予算 50ms）。&lt;br&gt;候補 4 台すべてで経路が作れないと金沢で 0.2 秒ほど止まるので、ASSIGN_CANDIDATES を増やすときは測り直すこと" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="1112" width="660" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p9-lc" value="フロントエンド（スマホ画面と徒歩キャラ）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F2FA;strokeColor=#6750A4;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#21005D;" parent="1" vertex="1">
                    <mxGeometry x="1340" y="100" width="720" height="1080" as="geometry"/>
                </mxCell>
                <mxCell id="p9-c1" value="&lt;b&gt;★ 乗車地点は選ばせない。利用者の現在地が乗車地点&lt;/b&gt;（実際の配車アプリと同じ）&lt;br&gt;画面で選ぶのは&lt;b&gt;降車地点だけ&lt;/b&gt;で、TaxiScreen が request_taxi の pickup に&lt;br&gt;store/pedestrian.ts の座標を入れる。サーバー側の契約は変わらない。&lt;br&gt;&lt;b&gt;pickup は配車 1 件のあいだ動かない目標地点&lt;/b&gt;で、呼んだ後に利用者が歩いても追従しない&lt;br&gt;&lt;br&gt;&lt;b&gt;★ approaching になっても利用者を乗車地点へ動かさないこと&lt;/b&gt;&lt;br&gt;乗車地点は自分の足元なので、立たせ直すと&lt;b&gt;呼んだ瞬間に自分がワープする&lt;/b&gt;。&lt;br&gt;立たせるのはリロード・再マウントで街から消えているときだけ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="146" width="680" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p9-c2" value="&lt;b&gt;panel/TaxiMap.tsx&lt;/b&gt;　スマホ画面の 2D 地図（3D シーンは使わず自前で描く）&lt;br&gt;配車の段階に合わせて&lt;b&gt;自動で寄り引きし、向きも変える&lt;/b&gt;&lt;br&gt;・&lt;b&gt;見え方（MapView）を useState に置かない&lt;/b&gt;。毎フレーム目標へ寄せるので、&lt;br&gt;　state にすると 60Hz でパネルごと再レンダリングされる&lt;br&gt;・&lt;b&gt;道路と建物のレイヤは貼り替えて使い回す&lt;/b&gt;（金沢の 58,120 本で 1 フレームを使い切る）&lt;br&gt;・&lt;b&gt;静的レイヤは「画面の対角を一辺とする正方形」で描く&lt;/b&gt;。画面と同じ大きさで描くと、&lt;br&gt;　回して貼った瞬間に四隅が欠ける。対角ならどの角度でも覆える&lt;br&gt;・&lt;b&gt;倍率は対数で補間する&lt;/b&gt;（線形だと 1 倍から 16 倍へ寄るとき前半でほとんど動かない）&lt;br&gt;・&lt;b&gt;向きは寄り引きより遅く追わせる&lt;/b&gt;（交差点で画面が振られて酔う）。角度は近いほうへ回す&lt;br&gt;・&lt;b&gt;向きを進行方向へ合わせるのは乗車中だけ&lt;/b&gt;。迎車中は北で固定（自分の居場所を掴むため）&lt;br&gt;・&lt;b&gt;軸ごとの toCanvasX / toCanvasY は廃止&lt;/b&gt;。回転が入ると x は y にも依存する&lt;br&gt;&lt;i&gt;実測：金沢の実用モードで中央値 16.7ms（60fps 相当）。地図の有無で差は出ない&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="300" width="680" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p9-c3" value="&lt;b&gt;panel/TaxiCameraView.tsx ＋ scene/TaxiCameraFeed.tsx&lt;/b&gt;　車載カメラ（→ ページ 5）&lt;br&gt;映像は&lt;b&gt;地図へ重ねる&lt;/b&gt;（地図の寸法は変えない）。縮める形にすると、開閉のたびに&lt;br&gt;道路・建物のレイヤを描き直すことになる&lt;br&gt;&lt;br&gt;&lt;b&gt;scene/NavScreen.tsx&lt;/b&gt;　インパネ中央のカーナビ&lt;br&gt;・&lt;b&gt;見ている 1 台にだけ出す&lt;/b&gt;（車両は InstancedMesh で 1 つのテクスチャしか持てない）&lt;br&gt;・&lt;b&gt;縮尺は速度で決める&lt;/b&gt;（停車で 80m 四方、最高速で 320m 四方）。寄り引きは 1〜2 秒かけて追う&lt;br&gt;・向きは進行方向が上。12fps で描き直す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="524" width="680" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p9-c4" value="&lt;b&gt;乗っている車のスロットは pedestrian.ridingVehicle に覚える&lt;/b&gt;&lt;br&gt;taxi.vehicleId は降車が確定した時点で &lt;b&gt;-1 に戻る&lt;/b&gt;ので、降車位置を出すのに使えない&lt;br&gt;（使うと乗車地点へワープする）。降りるのは車体の&lt;b&gt;左側面&lt;/b&gt;の外（左側通行なので歩道側）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="688" width="680" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="p9-c5" value="&lt;b&gt;配車の自動操作（store/taxiAutopilot.ts）&lt;/b&gt;　デバッグ用の隠し機能&lt;br&gt;スマホ画面の&lt;b&gt;時計を続けて 5 回叩く&lt;/b&gt;と、配車を最初から最後まで自分で回す&lt;br&gt;（呼ぶ → 迎車 → 歩いて近づく → 乗車 → 走行 → 到着 → 降車 → 1.5 秒待って次）。&lt;br&gt;&lt;b&gt;画面に案内は出さない&lt;/b&gt;。合図は時計の色とコロンの明滅だけ&lt;br&gt;&lt;br&gt;・&lt;b&gt;判断（decideAutoAction）と実行を分ける&lt;/b&gt;。判断は純粋関数、送信と歩行は Pedestrian が担う&lt;br&gt;　（指令を出す順番は画面を見ても分からないので、npm run verify:taxiauto が数値で確かめる）&lt;br&gt;・&lt;b&gt;回すのは Pedestrian の useFrame から&lt;/b&gt;。TaxiScreen はパネルを閉じるとアンマウントされる&lt;br&gt;・&lt;b&gt;断られた指令では段階が変わらない&lt;/b&gt;。間隔を空けずに出すと 60fps で送り続け、&lt;br&gt;　スマホ画面が「いまは乗車できません」で埋まる&lt;br&gt;・&lt;b&gt;歩くのは input.forward を押す形にする&lt;/b&gt;。座標を直接動かすと建物の当たり判定を通らず壁を抜ける&lt;br&gt;・&lt;b&gt;開発モードへ戻すときは必ず切る&lt;/b&gt;（切らないと学習中に request_taxi が飛び続ける）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="778" width="680" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p9-c6" value="&lt;b&gt;灯火は 2 か所で決める（混ぜない）&lt;/b&gt;&lt;br&gt;制動灯・方向指示器 → &lt;b&gt;サーバー&lt;/b&gt;（制動は「指令が負か」で、経路の先読みは経路を持つ側にしかできない）&lt;br&gt;前照灯・ハザード → &lt;b&gt;クライアント&lt;/b&gt;（昼夜と配車の段階はクライアントにしか無い）&lt;br&gt;&lt;b&gt;ハザードは方向指示器より優先する&lt;/b&gt;——乗降を待っている車が右ウインカーだけ出していると、&lt;br&gt;外から見て発進するように見える" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="982" width="680" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p9-warn" value="&lt;b&gt;⚠ 未対応（code_review V-01）：迎車中のタクシーが「赤信号待ち」だけで引き継がれる&lt;/b&gt;&lt;br&gt;&lt;br&gt;_stalled() は「残り距離が 1m 以上縮まない時間」が &lt;b&gt;STALL_TIMEOUT_SEC（25 秒）&lt;/b&gt;続いたら「道が塞がっている」と判断する。&lt;b&gt;ところが赤信号は 30 秒続く&lt;/b&gt;（SIGNAL_GREEN_SEC 25 ＋ YELLOW 3 ＋ ALL_RED 2 ＝ 半周期）。&lt;br&gt;&lt;b&gt;実測&lt;/b&gt;：銀座・8 台・300 秒で 25 秒超の停滞が 17 件（最長 33.4 秒）／ 金沢で 4 件（最長 30.5 秒）。実際に配車を 12 件回すと「近づけない」判定が &lt;b&gt;5 回&lt;/b&gt;出て、&lt;br&gt;　うち 4 回は「停止線まで 0〜1m・速度 0・前走車も歩行者も居ない」＝ ただの赤信号待ちだった。&lt;br&gt;&lt;b&gt;直し方&lt;/b&gt;：止められている間（前方の赤信号・前走車・歩行者）は停滞の時計を進めない。「詰まっている」と「待たされている」を区別する。&lt;br&gt;　見るべき値（world.next_signal / env._lead_gap / env._pedestrian_gap）はすべて既に実装の中にある" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1210" width="2020" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p9-x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p9-s1" target="p9-b1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p9-x2" value="request_taxi / board_taxi / alight_taxi / cancel_taxi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7D5260;strokeWidth=2;endArrow=blockThin;startArrow=blockThin;startFill=1;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="p9-c1" target="p9-b1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>