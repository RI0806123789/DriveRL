    <diagram id="page-boot" name="2. 起動〜接続シーケンス">
        <mxGraphModel dx="1492" dy="851" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p2-title" value="2. 起動〜接続シーケンス" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1D1B20;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p2-sub" value="run.ps1 / run.cmd → backend/run.py → uvicorn → FastAPI lifespan → エンジンスレッド → チェックポイント復元 → ブラウザ接続 → init。&lt;br&gt;色は実行主体を表す：&lt;b&gt;橙&lt;/b&gt;＝起動スクリプト／&lt;b&gt;青&lt;/b&gt;＝asyncio イベントループ／&lt;b&gt;緑&lt;/b&gt;＝エンジンスレッド／&lt;b&gt;紫&lt;/b&gt;＝ブラウザ／&lt;b&gt;赤&lt;/b&gt;＝異常系" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1090" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s1" value="&lt;b&gt;run.ps1 -Dev&lt;/b&gt; ／ &lt;b&gt;run.cmd --dev&lt;/b&gt;&lt;br&gt;venv のパスを埋めるだけの薄いラッパー（実処理はゼロ）" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="120" width="420" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s2" value="&lt;b&gt;backend/run.py　main()&lt;/b&gt;&lt;br&gt;_force_utf8_console() → argparse（--dev と --build は排他）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="198" width="420" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s3" value="&lt;b&gt;_check_ports()&lt;/b&gt;　8000（--dev なら 5173 も）を確認&lt;br&gt;bind ではなく &lt;b&gt;connect&lt;/b&gt; で判定。127.0.0.1 と ::1 の両方を試す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="276" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p2-d1" value="ポートが埋まっている？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="420" y="360" width="260" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s4" value="&lt;b&gt;--build&lt;/b&gt; なら _build_frontend()（npm run build・約 1 分）&lt;br&gt;&lt;b&gt;--dev&lt;/b&gt; なら _spawn_vite()（CREATE_NEW_PROCESS_GROUP）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="462" width="420" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s5" value="&lt;b&gt;uvicorn.run(&quot;app.main:app&quot;, host, port)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=12;align=center;verticalAlign=middle;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="340" y="544" width="420" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s6" value="app.main を import → モジュールトップで &lt;b&gt;engine = SimulationEngine()&lt;/b&gt; を生成&lt;br&gt;（この時点ではスレッドはまだ立たない）。CORS 登録・ルート定義" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="616" width="420" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s7" value="&lt;b&gt;lifespan()&lt;/b&gt; 起動処理&lt;br&gt;① engine.start() → threading.Thread(name=&quot;sim-engine&quot;, daemon=True)&lt;br&gt;② asyncio.create_task(broadcast_loop())" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="698" width="420" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s8" value="&lt;b&gt;エンジンスレッド _run() 開始&lt;/b&gt;&lt;br&gt;import torch（遅延）→ torch.set_num_threads(4)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="790" width="420" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s9" value="&lt;b&gt;_ensure_trainer()&lt;/b&gt;&lt;br&gt;PPOTrainer(obs=66, act=2, hidden=(128,128)) を生成&lt;br&gt;→ trainer.load(data/checkpoints/shared_policy.pt)　&lt;b&gt;weights_only=True&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="868" width="420" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p2-d2" value="obsDim と hiddenSizes が一致？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="420" y="958" width="260" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s10" value="ウォームアップ推論を 1 回実行 → &lt;b&gt;idle ループ&lt;/b&gt;&lt;br&gt;_drain_inbox() のみ回し、self._env is None の間は 0.05 秒 sleep&lt;br&gt;&lt;i&gt;マップが読み込まれるまでここで待機する&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1064" width="420" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s11" value="&lt;b&gt;ブラウザ&lt;/b&gt;　main.tsx（React マウント前）→ startConnection()&lt;br&gt;new WebSocket(&#39;ws(s)://&#39; + location.host + &#39;/ws&#39;)&lt;br&gt;started フラグで StrictMode の二重実行をガード" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1156" width="420" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s12" value="&lt;b&gt;websocket_endpoint()&lt;/b&gt; が接続を受け付け、&lt;b&gt;init&lt;/b&gt; を 1 回だけ送信" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1248" width="420" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s13" value="handleRaw() → &lt;b&gt;applyServerMessage(&#39;init&#39;)&lt;/b&gt;&lt;br&gt;resetFrameBuffer() ／ handshaked = true ／ presets・config・params・status を保存&lt;br&gt;followTarget が maxVehicles を超えていれば 0 に丸める" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1318" width="420" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p2-s14" value="既読込マップがあれば &lt;b&gt;map&lt;/b&gt; を再送 ＋ engine.request_full_frame()&lt;br&gt;無ければマップ選択待ち（→ ページ 3 へ）" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1410" width="420" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p2-n1" value="&lt;b&gt;YES：起動を中止する&lt;/b&gt;&lt;br&gt;netstat -ano（&lt;b&gt;-p TCP は付けない&lt;/b&gt;＝IPv6 のみの&lt;br&gt;リスナーも拾うため）から PID を抽出し、&lt;br&gt;taskkill /F /T /PID &amp;lt;pid&amp;gt; を提示して sys.exit(1)&lt;br&gt;&lt;br&gt;埋まったまま進むと uvicorn の WinError 10048 と&lt;br&gt;Vite のスタックトレースが流れ、&lt;br&gt;「大量のエラーで起動できない」に見えてしまう" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="800" y="336" width="330" height="126" as="geometry"/>
                </mxCell>
                <mxCell id="p2-n2" value="&lt;b&gt;--reload は使わない&lt;/b&gt;&lt;br&gt;リロードのたびに学習スレッドが作り直され、&lt;br&gt;オンライン学習の途中経過が消えるため。&lt;br&gt;--dev が動かすのは Vite だけで、&lt;br&gt;バックエンドはどのモードでもリロードしない" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="800" y="520" width="330" height="94" as="geometry"/>
                </mxCell>
                <mxCell id="p2-n3" value="&lt;b&gt;NO：復元しない&lt;/b&gt;&lt;br&gt;load() が False を返し、_ensure_trainer() が&lt;br&gt;「観測次元が変わった」等を警告通知（status）。&lt;br&gt;既定の初期重みで学習を始める。&lt;br&gt;&lt;i&gt;config.OBS_DIM を変えた場合がこれに当たる&lt;/i&gt;&lt;br&gt;これまで 50 → 54 → 56 → 57 → &lt;b&gt;66&lt;/b&gt; と変えている&lt;br&gt;（66 は歩行者の欄 3×3 を足したとき）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="800" y="948" width="330" height="94" as="geometry"/>
                </mxCell>
                <mxCell id="p2-n4" value="&lt;b&gt;init の中身&lt;/b&gt;&lt;br&gt;protocolVersion&lt;br&gt;presets[]（id / name / centerLat / centerLon / radiusM）&lt;br&gt;protocolVersion は &lt;b&gt;2&lt;/b&gt;（歩行者クラスを足して detections.cls が 0〜5 に広がったとき上げた）&lt;br&gt;config { maxVehicles: 8, &lt;b&gt;maxPedestrians: 64&lt;/b&gt;, simHz: 20, &lt;b&gt;obsDim: 66&lt;/b&gt;, actionDim: 2 }&lt;br&gt;params { vehicleCount, &lt;b&gt;pedestrianCount&lt;/b&gt;, simSpeed, learningRate, … }&lt;br&gt;status { state, mapLoaded, presetId, renderPaused, learning, simSuspended, &lt;b&gt;practicalMode&lt;/b&gt; }" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="800" y="1218" width="330" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p2-n5" value="&lt;b&gt;再接続（自動）&lt;/b&gt;&lt;br&gt;onclose → scheduleReconnect()&lt;br&gt;300ms → ×1.8 → 上限 5000ms で再試行し続ける。&lt;br&gt;切断中は ControlPanel に操作不可ヴェールが出る。&lt;br&gt;再接続すると新しい init が来るので&lt;br&gt;resetFrameBuffer() により古い位置を引きずらない" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1140" width="280" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p2-n6" value="&lt;b&gt;終了時（Ctrl+C）&lt;/b&gt;&lt;br&gt;uvicorn.run() を囲む finally から _stop_vite()。&lt;br&gt;&lt;b&gt;taskkill /F /T&lt;/b&gt; でプロセスツリーごと落とす。&lt;br&gt;terminate() だと npm.cmd だけが死に、&lt;br&gt;実際に 5173 を掴んでいる node が残る。&lt;br&gt;strictPort: true なので残ると次回の起動が失敗する" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1380" width="280" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p2-n7" value="&lt;b&gt;.cmd / .bat には ASCII しか書かない&lt;/b&gt;&lt;br&gt;cmd.exe はバッチをコンソールのコードページ&lt;br&gt;（日本語 Windows では cp932）で読むため、&lt;br&gt;UTF-8 の日本語は文字化けし、壊れた行が&lt;br&gt;1 行ずつコマンドとして実行される。&lt;br&gt;.ps1 は逆に UTF-8 &lt;b&gt;BOM 付き&lt;/b&gt;で保存する" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="280" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p2-n8" value="&lt;b&gt;開発時のプロセス構成&lt;/b&gt;&lt;br&gt;uvicorn :8000（FastAPI + WS + 学習スレッド）&lt;br&gt;Vite :5173（npm 子プロセス）&lt;br&gt;ブラウザは localhost:5173 を開き、&lt;br&gt;Vite が /ws と /api を 8000 へ中継する。&lt;br&gt;&lt;b&gt;本番は uvicorn 単独&lt;/b&gt;（dist を / で静的配信）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="250" width="280" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s1" target="p2-s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s2" target="p2-s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s3" target="p2-d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f4" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-d1" target="p2-s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f5" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3261E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p2-d1" target="p2-n1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s4" target="p2-s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s5" target="p2-s6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s6" target="p2-s7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f9" value="① スレッド起動" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s7" target="p2-s8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s8" target="p2-s9" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s9" target="p2-d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f12" value="YES：重み・オプティマイザ状態・更新回数を復元" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-d2" target="p2-s10" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f13" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3261E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p2-d2" target="p2-n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s10" target="p2-s11" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f15" value="WebSocket 接続（開発時は Vite :5173 が中継）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s11" target="p2-s12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s12" target="p2-s13" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-s13" target="p2-s14" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-f18" value="② broadcast_loop() を並行起動（60Hz ポーリング）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p2-s7" target="p2-s12" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="330" y="731"/>
                            <mxPoint x="330" y="1270"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-map" name="3. マップ読込フロー">
        <mxGraphModel dx="1492" dy="851" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1450" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p3-title" value="3. マップ読込フロー（load_map）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1D1B20;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="800" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="p3-sub" value="プリセットは 4 つ（銀座 / 梅田 / 栄 / 金沢）。金沢だけ 12.3km 四方で 2 桁大きい。OSMnx の取得はイベントループを止めないよう asyncio.to_thread へ逃がし、World の構築だけがエンジンスレッドで行われる。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p3-l1" value="フロントエンド（ブラウザ）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F2FA;strokeColor=#6750A4;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#21005D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="300" height="1240" as="geometry"/>
                </mxCell>
                <mxCell id="p3-l2" value="asyncio イベントループ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EDF3FE;strokeColor=#0B57D0;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#041E49;" parent="1" vertex="1">
                    <mxGeometry x="360" y="100" width="300" height="1240" as="geometry"/>
                </mxCell>
                <mxCell id="p3-l3" value="ワーカースレッド（asyncio.to_thread）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FDF6F0;strokeColor=#B3541E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#3E1C00;" parent="1" vertex="1">
                    <mxGeometry x="680" y="100" width="480" height="1240" as="geometry"/>
                </mxCell>
                <mxCell id="p3-l4" value="エンジンスレッド sim-engine" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#072711;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="100" width="434" height="1240" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f1" value="&lt;b&gt;MapTab&lt;/b&gt; でプリセット選択&lt;br&gt;（銀座 / 梅田 / 栄 / 金沢）&lt;br&gt;send({ type: &#39;load_map&#39;, presetId })" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="150" width="260" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f2" value="markMapLoading(presetId)&lt;br&gt;楽観的に「読込中」を表示" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="234" width="260" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f3" value="&lt;b&gt;map 受信&lt;/b&gt; → applyServerMessage&lt;br&gt;resetFrameBuffer() → map を zustand へ&lt;br&gt;SimulatorView が map !== null を検知し&lt;br&gt;RoadNetwork / RoadMarkings / Buildings /&lt;br&gt;TrafficSignals / RouteLines / Vehicles /&lt;br&gt;Obstacles / InteractionPlane をマウント" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="880" width="260" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f4" value="CameraRig が bounds から俯瞰初期位置を計算&lt;br&gt;autoTheme がプリセットの実座標（centerLat /&lt;br&gt;centerLon）で昼夜を判定し直す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1010" width="260" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="p3-f5" value="&lt;b&gt;失敗時&lt;/b&gt;&lt;br&gt;error { code: &#39;MAP_LOAD_FAILED&#39; } を受信&lt;br&gt;→ errors 配列（末尾 5 件）へ&lt;br&gt;→ pendingPresetId を解除" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1104" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p3-a1" value="handle_client_message()&lt;br&gt;→ _spawn_background(handle_load_map())" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="380" y="150" width="260" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p3-a2" value="&lt;b&gt;_map_load_lock&lt;/b&gt; を取得&lt;br&gt;（同時に 2 つ読み込ませない）&lt;br&gt;→ engine.set_loading()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="380" y="226" width="260" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p3-a3" value="status { state: &#39;loading_map&#39; } を broadcast" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="380" y="308" width="260" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p3-a4" value="&lt;b&gt;await asyncio.to_thread(&lt;br&gt;　　_load_map_blocking, preset_id)&lt;/b&gt;&lt;br&gt;&lt;i&gt;この間もイベントループは止まらない&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="380" y="372" width="260" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p3-a5" value="_current_map_wire = data.to_wire()&lt;br&gt;→ &lt;b&gt;map メッセージを broadcast&lt;/b&gt;&lt;br&gt;（低頻度・大サイズ。nodes / edges /&lt;br&gt;buildings / signals / bounds）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="380" y="880" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p3-a6" value="engine.set_map(index, presetId, name)&lt;br&gt;→ _inbox に (&quot;set_map&quot;, …) を積むだけ&lt;br&gt;&lt;b&gt;_map_pending = True&lt;/b&gt;（取り込み完了まで&lt;br&gt;take_frame() がフレームを返さない）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="380" y="978" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w1" value="get_preset(presetId) → &lt;b&gt;load_map(preset)&lt;/b&gt;　（map/loader.py）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="150" width="440" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w2" value="&lt;b&gt;_read_cache()&lt;/b&gt;　data/map_cache/&amp;lt;presetId&amp;gt;.json&lt;br&gt;version が CACHE_VERSION（= 6）と一致するか？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="700" y="212" width="440" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w3" value="&lt;b&gt;_fetch_and_normalize()&lt;/b&gt;　※キャッシュミス時のみ（数十秒）&lt;br&gt;① ox.graph_from_point(network_type=&#39;drive&#39;, truncate_by_edge=False, retain_all=False)&lt;br&gt;② ox.project_graph()（UTM 投影）→ Transformer で&lt;br&gt;　　プリセット中心を UTM 化し、そこを原点とする &lt;b&gt;ENU 平面&lt;/b&gt;へ&lt;br&gt;③ ox.features_from_point(tags={&#39;building&#39;: True})" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="326" width="440" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w4" value="④ _collect_node_xy() / _collect_edges() で ENU 正規化&lt;br&gt;　　_renumber()：osmid → 0 始まりの連番へ&lt;br&gt;⑤ _collect_buildings()：simplify・最小面積で間引き・穴は無視&lt;br&gt;　　height / building:levels が無ければ一律 &lt;b&gt;9m&lt;/b&gt;&lt;br&gt;⑥ _build_signals()：SIGNALS_AT_ALL_INTERSECTIONS = True のため&lt;br&gt;　　&lt;b&gt;すべての交差点&lt;/b&gt;（接続 3 本以上）に設置。進入路ごとに 1 基、&lt;br&gt;　　group は軸角度で分類" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="450" width="440" height="126" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w5" value="⑦ _compute_bounds() → &lt;b&gt;MapData&lt;/b&gt; を構築&lt;br&gt;⑧ _write_cache()：.json.tmp へ書いて os.replace（アトミック）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="594" width="440" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p3-w6" value="&lt;b&gt;build_map_index(data)&lt;/b&gt; → MapIndexImpl（map/index.py）&lt;br&gt;・ノード座標を numpy 配列化&lt;br&gt;・_build_graph()：oneway を尊重した networkx.DiGraph&lt;br&gt;・エッジ中心線 / 建物ポリゴンの shapely &lt;b&gt;STRtree&lt;/b&gt;&lt;br&gt;・_build_occupancy()：占有グリッド（GRID_CELL_SIZE = 1.0m、building レイヤのみ）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="666" width="440" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e1" value="&lt;b&gt;_drain_inbox()&lt;/b&gt; が &quot;set_map&quot; を取り出す" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="978" width="394" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e2" value="&lt;b&gt;_install_map()&lt;/b&gt;&lt;br&gt;SimulationEnv(map_index, params, seed=0) を生成&lt;br&gt;→ 内部で World(map_index, rng) と SignalController を構築&lt;br&gt;→ &lt;b&gt;PedestrianCrowd（歩道網を前処理）&lt;/b&gt;も同時に作る&lt;br&gt;&lt;i&gt;金沢は 57,128 本ぶんで 0.64 秒かかる（code_review V-06）&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="1042" width="394" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e3" value="&lt;b&gt;env.reset_all()&lt;/b&gt; → world.relocate_pedestrians() ＋ 各スロットで&lt;br&gt;world.respawn() → _random_route()&lt;br&gt;→ map_index.random_node_pair()&lt;br&gt;→ map_index.shortest_path()&lt;br&gt;→ map_index.lane_route_polyline()&lt;br&gt;→ _install_route()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="1128" width="394" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p3-e4" value="_ensure_trainer()（既存なら何もしない）→ trainer.apply_params()&lt;br&gt;→ &lt;b&gt;trainer.reset_rollout()&lt;/b&gt;（収集中のロールアウトを破棄。&lt;br&gt;新旧マップをまたぐ GAE を防ぐ）&lt;br&gt;→ _state = &quot;running&quot; ／ _map_pending = False → 初期フレーム生成" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="1252" width="394" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="p3-note1" value="&lt;b&gt;map/lanes.py — 車線に沿った経路の生成&lt;/b&gt;（build_lane_route()。スポーンのたびに呼ばれる）&lt;br&gt;道路中心線ではなく&lt;b&gt;左側通行の車線&lt;/b&gt;に沿わせる。既定は最も左の車線（lane_offset_left()）。&lt;br&gt;右左折の手前では道交法 34 条どおり寄せる（右折は 35m 手前から中央寄り）。交差点内は &lt;b&gt;ベジエ曲線&lt;/b&gt;（_bezier()）でつなぐ。&lt;br&gt;ROUTE_RESAMPLE_M = 2.0m で再サンプリングする。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="800" width="894" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="p3-note2" value="&lt;b&gt;プリセットの規模&lt;/b&gt;（SIGNALS_AT_ALL_INTERSECTIONS = True の効果）&lt;br&gt;　銀座：交差点 138 → 信号ノード 138（OSM タグ通りなら 27）／灯器 261（51）&lt;br&gt;　梅田：交差点 34 → 信号ノード 34（7）／灯器 73（16）&lt;br&gt;　栄　：交差点 78 → 信号ノード 78（45）／灯器 151（91）&lt;br&gt;　金沢：灯器 2,736 ／ ノード 19,493 ／ 道路 58,120 ／ 建物 35,607 ／ 標識 15,719&lt;br&gt;代償：経路 645m あたり信号 12 基。平均速度 4.5km/h（時間の 57.6% を停止）、&lt;br&gt;赤信号無視が通過あたり 0.8% → 7%。False に戻すと OSM のタグ通りになる&lt;br&gt;（そのときは CACHE_VERSION を上げてキャッシュを作り直すこと）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="1042" width="470" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p3-note3" value="&lt;b&gt;既知の弱点&lt;/b&gt;&lt;br&gt;・高架を地上道路として扱う（OSM の bridge / layer を無視）&lt;br&gt;・梅田プリセットが疎い（49 ノード。中心が JR 大阪駅のホーム上で&lt;br&gt;　最寄りの走行可能道路まで 113m）&lt;br&gt;・建物の中庭を無視（外周のみを実体として扱う）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="700" y="1198" width="470" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p3-note4" value="&lt;b&gt;事前ダウンロード&lt;/b&gt;&lt;br&gt;python -m app.map.prefetch&lt;br&gt;3 プリセットを先に map_cache へ&lt;br&gt;落としておける（1 エリア数十秒）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1206" width="260" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#49454F;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-f1" target="p3-f2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x2" value="WS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p3-f1" target="p3-a1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-a1" target="p3-a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-a2" target="p3-a3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-a3" target="p3-a4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x6" value="スレッド委譲" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3541E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p3-a4" target="p3-w1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="672" y="405"/>
                            <mxPoint x="672" y="172"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p3-x7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3541E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-w1" target="p3-w2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x8" value="MISS（未取得 / 版が古い）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3261E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-w2" target="p3-w3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3541E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-w3" target="p3-w4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3541E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-w4" target="p3-w5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3541E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-w5" target="p3-w6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x12" value="HIT（そのまま使う）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p3-w2" target="p3-w6" edge="1">
