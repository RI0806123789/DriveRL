<mxfile host="65bd71144e">
    <diagram id="page-overview" name="1. システム全体構成">
        <mxGraphModel dx="1492" dy="851" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1460" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p1-title" value="DriveRL — システム全体構成" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#1D1B20;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p1-sub" value="OSM の実地図上で複数車両を自作 PPO によりオンライン学習させ、WebSocket で配信して React / Three.js で描く。&lt;b&gt;車両は擬似カメラ画像を CNN で認識した結果だけを見て走る&lt;/b&gt;（観測 66 次元）。プロセスは開発時 2 つ（uvicorn / Vite）、本番は uvicorn 単独。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#49454F;" parent="1" vertex="1">
                    <mxGeometry x="40" y="58" width="1186" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p1-osm" value="&lt;b&gt;OpenStreetMap / Overpass API&lt;/b&gt;&lt;br&gt;外部 HTTPS。map_cache がミスしたときだけ叩く（1 エリア数十秒）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDAD6;strokeColor=#B3261E;fontColor=#410E0B;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1244" y="20" width="370" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="p1-c-browser" value="ブラウザ（同一オリジン）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7F2FA;strokeColor=#6750A4;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#21005D;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="400" height="890" as="geometry"/>
                </mxCell>
                <mxCell id="p1-main" value="&lt;b&gt;main.tsx / App.tsx&lt;/b&gt;&lt;br&gt;React マウント前に startConnection()。左:右 = 2:1、M キーでパネル開閉" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="152" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p1-conn" value="&lt;b&gt;store/connection.ts&lt;/b&gt;&lt;br&gt;WebSocket クライアント。URL は location.host + /ws（同一オリジン相対）&lt;br&gt;再接続：300ms → ×1.8 → 上限 5000ms" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="212" width="360" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p1-store" value="&lt;b&gt;store/simStore.ts&lt;/b&gt;&lt;br&gt;zustand。低頻度の状態のみ&lt;br&gt;applyServerMessage()&lt;br&gt;mockServer.ts（?mock=1 で&lt;br&gt;バックエンド無しで動く）&lt;br&gt;pwa.ts（SW 登録。本番のみ）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="284" width="172" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="p1-fb" value="&lt;b&gt;store/frameBuffer.ts&lt;/b&gt;&lt;br&gt;20Hz frame 専用の可変オブジェクト&lt;br&gt;&lt;i&gt;React の外&lt;/i&gt;&lt;br&gt;同じ作法：pedestrian.ts（徒歩キャラ）/ taxiCamera.ts（車載カメラ）/ taxiAutopilot.ts" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="248" y="284" width="172" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="p1-panel" value="&lt;b&gt;panel/&lt;/b&gt;&lt;br&gt;ControlPanel（key={tab} で&lt;br&gt;アンマウントして入れ替え）&lt;br&gt;Simulation / Map / Learning&lt;br&gt;View / &lt;b&gt;Model（認識器を学習）&lt;/b&gt;&lt;br&gt;MetricsChart / NetworkGraph" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="386" width="172" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p1-scene" value="&lt;b&gt;scene/&lt;/b&gt;（R3F）&lt;br&gt;SimulatorView / Vehicles&lt;br&gt;CameraRig / RoadNetwork&lt;br&gt;Buildings / TrafficSignals&lt;br&gt;&lt;b&gt;PedestrianSignals&lt;/b&gt; / Rain&lt;br&gt;&lt;b&gt;NpcPedestrians&lt;/b&gt; / SpeedSigns" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EADDFF;strokeColor=#6750A4;fontColor=#21005D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="248" y="386" width="172" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p1-taxiui" value="&lt;b&gt;実用モードの画面&lt;/b&gt;（開発モードとは&lt;b&gt;排他&lt;/b&gt;。トグルで入れ替わる）&lt;br&gt;panel/&lt;b&gt;TaxiScreen&lt;/b&gt;（スマホ画面）/ TaxiMap（2D 地図・自動で寄り引きし向きも変える）/ TaxiCameraView&lt;br&gt;scene/&lt;b&gt;Pedestrian&lt;/b&gt;（徒歩キャラ。WASD ＋ ポインタロック）/ TaxiMarkers / TaxiHud&lt;br&gt;scene/&lt;b&gt;NavScreen&lt;/b&gt;（インパネのカーナビ。12fps）/ &lt;b&gt;TaxiCameraFeed&lt;/b&gt;（車載カメラ。15fps でオフスクリーン → 2D キャンバスへ転送）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="508" width="360" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="p1-ui" value="&lt;b&gt;ui/ + styles/&lt;/b&gt;&lt;br&gt;Material 3 Expressive 部品&lt;br&gt;動かしてよいのは&lt;br&gt;transform と opacity だけ" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="604" width="172" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p1-export" value="&lt;b&gt;store/exportModel.ts&lt;/b&gt;&lt;br&gt;fetch はここ 2 関数のみ&lt;br&gt;downloadModel / importModel" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="248" y="604" width="172" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p1-proto" value="&lt;b&gt;types/protocol.ts&lt;/b&gt; — docs/protocol.md（&lt;b&gt;v2&lt;/b&gt;）の TypeScript 表現。ServerMessage / ClientMessage 全型と、段階の述語（isRidingPhase / isBoardablePhase / isWaitingPhase）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="684" width="360" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p1-theme" value="&lt;b&gt;配色の自動切替&lt;/b&gt;：sunTimes.ts（NOAA 日の出方程式）→ themeClock.ts（純粋）→ autoTheme.ts（次の切替時刻 1 点に setTimeout）→ palette.ts（3D 用 2 組）&lt;br&gt;外部 API も geolocation も使わない。走らせている街の実座標で判定する" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8DEF8;strokeColor=#7D5260;fontColor=#31111D;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="750" width="360" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p1-fnote" value="&lt;b&gt;フロント側の不変条件&lt;/b&gt;&lt;br&gt;・20Hz の frame は zustand に入れない（React が毎秒 20 回再描画されるため）&lt;br&gt;・60fps で書き換わるもの（徒歩キャラの位置・車載カメラ）も同じ&lt;br&gt;・3D の色は palette.ts の 2 組だけに書く（CSS 変数は three から読めない）&lt;br&gt;・車両・歩行者・灯火・プレートは InstancedMesh。palette を args に渡さない&lt;br&gt;　（マテリアルごと作り直されると count=0 に戻って物体が消える）&lt;br&gt;・幾何は React から切り離した純粋モジュールへ置き、npm run verify で数値検査する" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="60" y="822" width="360" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p1-fsize" value="React 19 ・ @react-three/fiber 9 ・ three 0.185 ・ zustand 5（★ 行数・ファイル数は書かない。手で書いた数字は必ず古くなる）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#49454F;" parent="1" vertex="1">
                    <mxGeometry x="60" y="958" width="360" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="p1-c-vite" value="Vite :5173（--dev 時のみ）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#B3541E;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#3E1C00;" parent="1" vertex="1">
                    <mxGeometry x="470" y="196" width="190" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p1-vite" value="/ws  → ws://127.0.0.1:8000&lt;br&gt;/api → http://127.0.0.1:8000&lt;br&gt;&lt;br&gt;port 5173 / &lt;b&gt;strictPort: true&lt;/b&gt;&lt;br&gt;（衝突時はフォールバックせず起動失敗）&lt;br&gt;&lt;br&gt;停止は taskkill /F /T&lt;br&gt;（terminate() では node が残る）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="482" y="234" width="166" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p1-pwa" value="&lt;b&gt;PWA（frontend/public/）&lt;/b&gt;&lt;br&gt;manifest.webmanifest&lt;br&gt;　display: fullscreen&lt;br&gt;sw.js（手書き。ライブラリを足さない）&lt;br&gt;　CACHE_VERSION = v2&lt;br&gt;　/api/ と GET 以外は素通し&lt;br&gt;　HTML はネットワーク優先&lt;br&gt;　/assets/ だけキャッシュ優先（件数上限つき）&lt;br&gt;icon-*.png（scripts/make-icons.ts）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#E8A33D;fontColor=#3E2E00;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="470" y="412" width="190" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p1-verify" value="&lt;b&gt;npm run verify&lt;/b&gt;&lt;br&gt;ブラウザ無しで 3D の幾何を数値検証する。&lt;br&gt;&lt;b&gt;本数の出典は package.json の scripts&lt;/b&gt;&lt;br&gt;（ここに本数を書かない）&lt;br&gt;&lt;br&gt;3D の向きは間違っていても&lt;br&gt;型チェックもビルドも通るため" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="470" y="600" width="190" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p1-c-uvicorn" value="uvicorn プロセス :8000（.env の DRIVERL_HOST / DRIVERL_PORT）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5FAF6;strokeColor=#146C2E;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#072711;" parent="1" vertex="1">
                    <mxGeometry x="690" y="110" width="924" height="890" as="geometry"/>
                </mxCell>
                <mxCell id="p1-c-async" value="asyncio イベントループ（app/main.py）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDF3FE;strokeColor=#0B57D0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#041E49;" parent="1" vertex="1">
                    <mxGeometry x="706" y="150" width="892" height="212" as="geometry"/>
                </mxCell>
                <mxCell id="p1-ws" value="&lt;b&gt;WS /ws&lt;/b&gt;&lt;br&gt;websocket_endpoint()&lt;br&gt;handle_client_message()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="720" y="192" width="206" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p1-bcast" value="&lt;b&gt;broadcast_loop()&lt;/b&gt;（60Hz ポーリング）&lt;br&gt;frame / status / params&lt;br&gt;metrics・network・detector(1Hz)&lt;br&gt;&lt;b&gt;taxi&lt;/b&gt;（段階・車両番号が変わったときと 1Hz）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="936" y="192" width="206" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p1-http" value="&lt;b&gt;HTTP ルート&lt;/b&gt;&lt;br&gt;GET /api/health&lt;br&gt;GET /api/export/{kind}&lt;br&gt;POST /api/import" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1152" y="192" width="212" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p1-loadmap" value="&lt;b&gt;handle_load_map()&lt;/b&gt;&lt;br&gt;_map_load_lock で二重読込防止&lt;br&gt;await asyncio.to_thread(...)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1374" y="192" width="210" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="p1-static" value="静的配信（本番）：frontend/dist を / にマウント。index.html は no-cache、/assets/* は immutable、sw.js と manifest は no-cache" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF1FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="720" y="268" width="422" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p1-anote" value="&lt;b&gt;重い処理をここに書かない。&lt;/b&gt;OSM 取得は to_thread、物理・学習・認識はエンジンスレッド、認識器の学習はさらに別スレッド" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1152" y="268" width="432" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p1-bridge" value="&lt;b&gt;スレッド境界（これ以外の共有をしない）&lt;/b&gt;　queue.Queue：_inbox（asyncio → engine）／ _notices（engine → asyncio）　threading.Lock：_latest_frame / _metrics / _network / _taxi / _detector" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=center;verticalAlign=middle;fontStyle=0" parent="1" vertex="1">
                    <mxGeometry x="706" y="376" width="892" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p1-c-worker" value="ワーカースレッド（asyncio.to_thread）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6F0;strokeColor=#B3541E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E1C00;" parent="1" vertex="1">
                    <mxGeometry x="706" y="444" width="360" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="p1-loader" value="&lt;b&gt;map/loader.py&lt;/b&gt;&lt;br&gt;OSMnx 取得 → UTM 投影 → ENU 正規化&lt;br&gt;建物・信号・標識を抽出 → JSON キャッシュ（CACHE_VERSION = 6）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="718" y="480" width="336" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="p1-index" value="&lt;b&gt;map/index.py&lt;/b&gt; MapIndexImpl — DiGraph・STRtree・占有グリッド（1.0m）&lt;br&gt;map/lanes.py で左側通行の車線経路を生成" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="718" y="544" width="336" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p1-c-dett" value="認識器の学習スレッド detector-train" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDF6F0;strokeColor=#B3541E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3E1C00;" parent="1" vertex="1">
                    <mxGeometry x="706" y="620" width="360" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p1-detjob" value="&lt;b&gt;runtime/detector_job.py&lt;/b&gt;&lt;br&gt;採点（percep/evaluate）→ 収集 → 学習 → 保存&lt;br&gt;&lt;b&gt;走っている間だけ engine.suspend_sim()&lt;/b&gt;&lt;br&gt;　物理と PPO を止める（配信とコマンドは動く）&lt;br&gt;　理由① 収集も学習も CPU を使い切る&lt;br&gt;　理由② 正解ラベルの静的キャッシュは&lt;br&gt;　　map_index の identity 比較 1 件だけ&lt;br&gt;&lt;b&gt;値域（枚数・エポック等）の唯一の出典&lt;/b&gt;。CLI も UI もここを見る" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFDFC2;strokeColor=#B3541E;fontColor=#3E1C00;fontSize=10;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="718" y="656" width="336" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="p1-c-engine" value="エンジンスレッド sim-engine（threading.Thread, daemon）— 1 ステップの予算 50ms（20Hz）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F9F3;strokeColor=#146C2E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#072711;" parent="1" vertex="1">
                    <mxGeometry x="1086" y="444" width="512" height="326" as="geometry"/>
                </mxCell>
                <mxCell id="p1-engine" value="&lt;b&gt;runtime/engine.py&lt;/b&gt; SimulationEngine — _run() / _step_once() / _install_map() / _drain_inbox() / _apply_app_mode() / _apply_player_pose()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1098" y="480" width="488" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p1-sim" value="&lt;b&gt;sim/&lt;/b&gt;&lt;br&gt;env.py SimulationEnv&lt;br&gt;world.py World&lt;br&gt;vehicle.py VehicleFleet&lt;br&gt;signals.py SignalController&lt;br&gt;&lt;b&gt;pedestrians.py&lt;/b&gt; PedestrianCrowd" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1098" y="542" width="238" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p1-rl" value="&lt;b&gt;rl/&lt;/b&gt; &lt;b&gt;自作 PPO&lt;/b&gt;&lt;br&gt;policy.py ActorCritic（平均は tanh）&lt;br&gt;ppo.py PPOTrainer&lt;br&gt;buffer.py RolloutBuffer&lt;br&gt;export.py / importer.py&lt;br&gt;&lt;b&gt;warmstart.py&lt;/b&gt;（行動クローニング）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1348" y="542" width="238" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p1-percep" value="&lt;b&gt;percep/&lt;/b&gt; &lt;b&gt;画像認識&lt;/b&gt;（→ ページ 5）&lt;br&gt;weather.py 天候（視程の唯一の出典）&lt;br&gt;camera.py 擬似カメラ 192×144&lt;br&gt;detector.py CNN（Keras 3 / torch）&lt;br&gt;groundtruth.py 真値の検出結果&lt;br&gt;encoder.py → 観測 66 次元" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1098" y="656" width="238" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p1-taxi" value="&lt;b&gt;runtime/taxi.py&lt;/b&gt; 実用モード（→ ページ 9）&lt;br&gt;配車 1 件ぶんの状態（同時 1 件）&lt;br&gt;徴用 → 迎車 → 乗車 → 走行 → 降車&lt;br&gt;来られない車は&lt;b&gt;別の車へ引き継ぐ&lt;/b&gt;&lt;br&gt;&lt;i&gt;実用モードの間は全車が経路追従&lt;/i&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1348" y="656" width="238" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="p1-shared" value="&lt;b&gt;app/contracts.py&lt;/b&gt;　内部共有型のみを介して map / sim / rl / runtime / percep がやり取りする。camelCase 変換は to_wire() に閉じ込める（依存を持たない中立地帯）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D3E3FD;strokeColor=#0B57D0;fontColor=#041E49;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="706" y="786" width="892" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="p1-bnote" value="&lt;b&gt;バックエンド側の不変条件&lt;/b&gt;&lt;br&gt;・&lt;b&gt;観測はカメラ由来、報酬と終了条件は真値由来。&lt;/b&gt;霧で赤信号を見落として進めば、そのとおり罰が入る&lt;br&gt;・config.OBS_DIM（= 66）を変えると書き出し済みモデルがすべて読めなくなる（50 → 54 → 56 → 57 → 66 の履歴）&lt;br&gt;・チェックポイントは必ず weights_only=True で読む（フォールバックしない）&lt;br&gt;・&lt;b&gt;失敗を黙って握りつぶさない。&lt;/b&gt;認識・衝突・規制速度の判定は、失敗すると「成績が良くなる方向」へ倒れる → _warn_once() で初回だけ記録&lt;br&gt;・版番号は中身の意味を変えたら上げる：CACHE_VERSION（map / sw.js）・CHECKPOINT_FORMAT（rl）・DATASET_VERSION（percep = 3）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="706" y="848" width="892" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p1-c-data" value="backend/data/（生成物。消してよいが、マップの再取得と学習のやり直しが要る）" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4F1F4;strokeColor=#79747E;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=15;fontStyle=1;fontColor=#1D1B20;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1030" width="1574" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="p1-d1" value="&lt;b&gt;osmnx_cache/&lt;/b&gt;&lt;br&gt;&lt;br&gt;書く：OSMnx ライブラリ自身&lt;br&gt;（Overpass に実際に問い合わせたとき）&lt;br&gt;読む：OSMnx が同一クエリ再取得時&lt;br&gt;自動削除なし" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1076" width="296" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p1-d2" value="&lt;b&gt;map_cache/&lt;/b&gt;&lt;br&gt;ginza.json / umeda.json / sakae.json / kanazawa.json&lt;br&gt;書く：_write_cache()（.tmp → os.replace）&lt;br&gt;読む：load_map()（version が CACHE_VERSION と一致したときだけ）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="372" y="1076" width="296" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p1-d3" value="&lt;b&gt;checkpoints/shared_policy.pt&lt;/b&gt;&lt;br&gt;書く：PPO 更新 20 回ごとの自動保存 ／&lt;br&gt;save_checkpoint ／ import 直後&lt;br&gt;読む：サーバー起動時（_ensure_trainer）&lt;br&gt;&lt;b&gt;.before-warmstart&lt;/b&gt;：warmstart_policy.py が退避" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4EED0;strokeColor=#146C2E;fontColor=#072711;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="684" y="1076" width="296" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p1-d4" value="&lt;b&gt;exports/&lt;/b&gt;&lt;br&gt;.pt ／ .torchscript.pt ／ .keras&lt;br&gt;書く：GET /api/export ／ import 直前の&lt;br&gt;自動退避（..._before-import_...）&lt;br&gt;&lt;b&gt;観測レイアウトと行動スケールを&lt;br&gt;メタデータに必ず埋める&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="996" y="1076" width="296" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p1-d5" value="&lt;b&gt;uploads/&lt;/b&gt;&lt;br&gt;書く：POST /api/import が 1MB ずつ&lt;br&gt;（上限 256MB、超過は 413）&lt;br&gt;読む：エンジンスレッドが検証&lt;br&gt;（weights_only=True）&lt;br&gt;読み終えたら消す＋残骸のローテーション" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6E0E9;strokeColor=#79747E;fontColor=#1D1B20;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1308" y="1076" width="290" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p1-d6" value="&lt;b&gt;detector/&lt;/b&gt;&lt;br&gt;detector.keras（CNN の重み）&lt;br&gt;dataset/detector_dataset.npz&lt;br&gt;　（DATASET_VERSION = 3。画像は uint8 のまま持つ）&lt;br&gt;書く：train_detector.py ／「モデル作成」タブ&lt;br&gt;読む：env.reload_detector()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontColor=#1D1B20;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1234" width="296" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p1-dnote" value="&lt;b&gt;認識器が載っていないときは真値で走る。&lt;/b&gt;detector.keras が無い／推論が落ちた場合は groundtruth.py が同じ形の検出結果を返す（＝教師データ作りとフォールバックの二役）。&lt;br&gt;画面の「観測の出どころ」は engine が 1Hz で取り直すので、落ちたら「真値」に戻る。&lt;b&gt;握ったままにすると、真値で走っているのに『CNN の認識結果』と出たまま遅くなる。&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;実測（この PC・8 台・銀座／金沢）&lt;/b&gt;　真値だけなら 1 ステップ 6.5 / 10.4ms（歩行者 0 人）〜 9.9 / 14.0ms（64 人）。&lt;b&gt;認識器を載せると 44〜50ms&lt;/b&gt; で、50ms の予算をほぼ使い切る（code_review V-07）。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#A88400;fontColor=#3E2E00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="372" y="1234" width="1226" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p1-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;startArrow=blockThin;startFill=1;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p1-conn" target="p1-ws" edge="1">
