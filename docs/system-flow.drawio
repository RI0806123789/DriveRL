                <mxCell id="p3-x13" value="戻り値 (preset, data, index)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p3-w6" target="p3-a5" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="672" y="719"/>
                            <mxPoint x="672" y="920"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p3-x14" value="map メッセージ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p3-a5" target="p3-f3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B57D0;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-a5" target="p3-a6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x16" value="_inbox 経由" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p3-a6" target="p3-e1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-e1" target="p3-e2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-e2" target="p3-e3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-e3" target="p3-e4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x20" value="ページ 4（実行時ループ）へ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#146C2E;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="p3-e4" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1620" y="1292" as="target"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p3-x21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6750A4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p3-f3" target="p3-f4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-x22" value="例外発生時" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B3261E;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p3-a4" target="p3-f5" edge="1">
